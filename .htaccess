# Kolokolo — routage Apache / Hostinger vers l’entrée Node
# Fichier de démarrage : src/app.js
#
# Sur un site « Node.js Web App » Hostinger, hPanel peut régénérer
# ce fichier au redéploiement : revérifier l’entry file dans les réglages.

PassengerEnabled On
PassengerAppType node
PassengerStartupFile src/app.js

# Pas d’index.html : la racine (/) est gérée par Express
DirectoryIndex disabled

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# Forcer HTTPS (désactiver en local si besoin)
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !https
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

	# Transmettre l’en-tête Authorization à Node
	RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

	# Laisser Passenger / Node traiter toutes les routes
	# (Express sert déjà /public via express.static)
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteRule ^(.*)$ - [L]
</IfModule>

# Bloquer l’accès HTTP direct aux secrets et sources
<IfModule mod_authz_core.c>
	<FilesMatch "(^\.env|\.env\.|^\.git|package(-lock)?\.json|knexfile\.js)">
		Require all denied
	</FilesMatch>
</IfModule>

RedirectMatch 404 /\.git
RedirectMatch 404 /\.env
