# Kolokolo — Hostinger (repo complet sur public_html, site dans dist/)
# Les URLs restent /, /a-propos, /assets/… ; Apache sert les fichiers sous dist/.

DirectoryIndex dist/index.html index.html

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# HTTPS
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !https
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

	# Bloquer l’accès direct au code source / secrets
	RewriteRule ^(src|views|migrations|scripts|node_modules|\.github)(/|$) - [F,L]
	RewriteRule ^(\.env|package(-lock)?\.json|knexfile\.js)$ - [F,L]

	# Ne pas retravailler les chemins déjà sous dist/
	RewriteRule ^dist/ - [L]

	# Fichier ou dossier réel à la racine (ex. robots.txt un jour)
	RewriteCond %{REQUEST_FILENAME} -f [OR]
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteRule ^ - [L]

	# Tout le reste → dist/
	RewriteRule ^(.*)$ dist/$1 [L]
</IfModule>

ErrorDocument 404 /dist/404.html

<IfModule mod_authz_core.c>
	<FilesMatch "(^\.env|package(-lock)?\.json|knexfile\.js)">
		Require all denied
	</FilesMatch>
</IfModule>
