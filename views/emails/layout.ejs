<!DOCTYPE html>
<html lang="fr" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
	<meta charset="utf-8">
	<meta name="x-apple-disable-message-reformatting">
	<meta http-equiv="x-ua-compatible" content="ie=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
	<!--[if mso]>
		<xml><o:officedocumentsettings><o:pixelsperinch>96</o:pixelsperinch></o:officedocumentsettings></xml>
	<![endif]-->
	<title><%= title %></title>
	<link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet" media="screen">
	<style>
		.hover-underline:hover { text-decoration: underline !important; }
		.mail-body img { max-width: 100% !important; height: auto !important; }
		.mail-body p { margin: 0 0 16px; }
		.mail-body p:last-child { margin-bottom: 0; }
		@media (max-width: 600px) {
			.sm-w-full { width: 100% !important; }
			.sm-px-24 { padding-left: 24px !important; padding-right: 24px !important; }
			.sm-py-32 { padding-top: 32px !important; padding-bottom: 32px !important; }
			.sm-leading-32 { line-height: 32px !important; }
		}
	</style>
</head>
<body style="margin: 0; width: 100%; padding: 0; word-break: break-word; -webkit-font-smoothing: antialiased; background-color: <%= colors.bg %>;">
	<div style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; display: none;"><%= typeof preheader !== 'undefined' ? preheader : title %></div>
	<div role="article" aria-roledescription="email" aria-label="<%= title %>" lang="fr" style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly;">
		<table style="width: 100%; font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif;" cellpadding="0" cellspacing="0" role="presentation">
			<tr>
				<td align="center" style="mso-line-height-rule: exactly; background-color: <%= colors.bg %>; font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif;">
					<table class="sm-w-full" style="width: 600px;" cellpadding="0" cellspacing="0" role="presentation">
						<tr>
							<td class="sm-py-32 sm-px-24" style="mso-line-height-rule: exactly; padding: 48px; text-align: center; font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif;">
								<a href="<%= siteUrl %>" style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly;">
									<img src="<%= logoUrl %>" width="200" alt="Kolokolo" style="max-width: 100%; vertical-align: middle; line-height: 100%; border: 0;">
								</a>
							</td>
						</tr>
						<tr>
							<td align="center" class="sm-px-24" style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly;">
								<table style="width: 100%;" cellpadding="0" cellspacing="0" role="presentation">
									<tr>
										<td class="sm-px-24" style="mso-line-height-rule: exactly; border-radius: 4px; background-color: #ffffff; padding: 48px; text-align: left; font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; font-size: 16px; line-height: 24px; color: <%= colors.text %>;">
											<%- content %>
											<table style="width: 100%;" cellpadding="0" cellspacing="0" role="presentation">
												<tr>
													<td style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; padding-top: 32px; padding-bottom: 32px;">
														<div style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; height: 1px; background-color: <%= colors.bg %>; line-height: 1px;">&zwnj;</div>
													</td>
												</tr>
											</table>
											<p style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; margin: 0; margin-bottom: 16px;">
												Une question ? Écrivez-nous à
												<a href="mailto:<%= contactEmail %>" class="hover-underline" style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; color: <%= colors.red %>; text-decoration: none;"><%= contactEmail %></a>
												<% if (phone) { %> ou appelez le <a href="tel:<%= helpers.telHref(phone) %>" class="hover-underline" style="color: <%= colors.red %>; text-decoration: none;"><%= phone %></a><% } %>.
											</p>
											<p style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; margin: 0; margin-bottom: 16px;">À bientôt,<br>L’équipe Kolokolo</p>
										</td>
									</tr>
									<tr>
										<td style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; height: 20px;"></td>
									</tr>
									<tr>
										<td style="mso-line-height-rule: exactly; padding-left: 48px; padding-right: 48px; font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; font-size: 14px; color: <%= colors.bg %>;">
											<% if (socials.length) { %>
												<p align="center" style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; margin-bottom: 16px; cursor: default;">
													<% socials.forEach((item, index) => { %>
														<% if (index) { %>&nbsp;&bull;&nbsp;<% } %>
														<a href="<%= item.url %>" style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; color: <%= colors.ink %>; text-decoration: none;">
															<% if (item.icon) { %>
																<img src="<%= item.icon %>" width="17" alt="<%= item.label %>" style="max-width: 100%; vertical-align: middle; line-height: 100%; border: 0; margin-right: 4px;">
															<% } else { %><%= item.label %><% } %>
														</a>
													<% }) %>
												</p>
											<% } %>
											<p style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; color: <%= colors.ink %>;">
												<% if (place && place.address) { %><%= place.address %><% if (place.regionCountry) { %> — <%= place.regionCountry %><% } %><br><% } %>
												L’utilisation du site est soumise à nos
												<a href="<%= termsUrl %>" class="hover-underline" style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; color: <%= colors.red %>; text-decoration: none;">conditions générales</a>
												et à notre
												<a href="<%= privacyUrl %>" class="hover-underline" style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; color: <%= colors.red %>; text-decoration: none;">politique de confidentialité</a>.
											</p>
											<% if (typeof unsubscribeUrl !== 'undefined' && unsubscribeUrl) { %>
												<p style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; color: <%= colors.ink %>;">
													Vous ne souhaitez plus recevoir nos emails ?
													<a href="<%= unsubscribeUrl %>" class="hover-underline" style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; color: <%= colors.red %>; text-decoration: none;">Se désinscrire</a>
												</p>
											<% } %>
										</td>
									</tr>
									<tr>
										<td style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; height: 16px;"></td>
									</tr>
								</table>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</div>
</body>
</html>
