<p style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; margin-bottom: 0; font-size: 20px; font-weight: 600; color: <%= colors.ink %>;">Bonjour,</p>
<p class="sm-leading-32" style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; margin: 8px 0 24px; font-size: 24px; font-weight: 600; color: <%= colors.ink %>;">
	<%= subject %>
</p>
<div class="mail-body" style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; color: <%= colors.text %>; font-size: 16px; line-height: 24px;">
	<%- bodyHtml || '' %>
</div>
<table cellpadding="0" cellspacing="0" role="presentation" style="margin-top: 28px;">
	<tr>
		<td style="mso-line-height-rule: exactly; mso-padding-alt: 16px 24px; border-radius: 4px; background-color: <%= colors.red %>; font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif;">
			<a href="<%= siteUrl %>" style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; display: block; padding-left: 24px; padding-right: 24px; padding-top: 16px; padding-bottom: 16px; font-size: 16px; font-weight: 600; line-height: 100%; color: #ffffff; text-decoration: none;">Visiter le site &rarr;</a>
		</td>
	</tr>
</table>
