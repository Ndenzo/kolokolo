<p style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; margin-bottom: 0; font-size: 20px; font-weight: 600; color: <%= colors.ink %>;">Bonjour</p>
<% if (typeof greetingName !== 'undefined' && greetingName) { %>
	<p style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; margin-top: 0; font-size: 24px; font-weight: 700; color: <%= colors.red %>;"><%= greetingName %></p>
<% } %>
<p class="sm-leading-32" style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; margin: 0; margin-bottom: 16px; font-size: 24px; font-weight: 600; color: <%= colors.ink %>;">
	<%= heading %>
</p>
<% if (typeof intro !== 'undefined' && intro) { %>
	<p style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; margin: 0; margin-bottom: 24px;"><%= intro %></p>
<% } %>
<% if (rows && rows.length) { %>
	<table style="width: 100%;" cellpadding="0" cellspacing="0" role="presentation">
		<% rows.forEach((row, index) => { %>
			<tr>
				<td style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; width: 38%; padding-top: 10px; padding-bottom: 10px; border-bottom: 1px solid <%= colors.bg %>; font-size: 14px; color: #8a8a8a; vertical-align: top;"><%= row[0] %></td>
				<td style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; width: 62%; padding-top: 10px; padding-bottom: 10px; border-bottom: 1px solid <%= colors.bg %>; font-size: 16px; color: <%= colors.ink %>; white-space: pre-wrap; vertical-align: top;"><%= row[1] %></td>
			</tr>
		<% }) %>
	</table>
<% } %>
<% if (typeof ctaUrl !== 'undefined' && ctaUrl) { %>
	<table cellpadding="0" cellspacing="0" role="presentation" style="margin-top: 24px;">
		<tr>
			<td style="mso-line-height-rule: exactly; mso-padding-alt: 16px 24px; border-radius: 4px; background-color: <%= colors.red %>; font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif;">
				<a href="<%= ctaUrl %>" style="font-family: Roboto, Montserrat, -apple-system, 'Segoe UI', sans-serif; mso-line-height-rule: exactly; display: block; padding-left: 24px; padding-right: 24px; padding-top: 16px; padding-bottom: 16px; font-size: 16px; font-weight: 600; line-height: 100%; color: #ffffff; text-decoration: none;"><%= typeof ctaLabel !== 'undefined' && ctaLabel ? ctaLabel : 'Ouvrir' %> &rarr;</a>
			</td>
		</tr>
	</table>
<% } %>
