    <!-- header area start  -->
    <header>
        <div class="header__top d-none d-md-block">
            <div class="container">
                <div class="row d-flex align-items-center">
                    <div class="col-lg-9">
                        <div class="grb__cta header-cta">
                            <ul>
                                <li>
                                    <div class="cta__icon">
                                        <span><i class="fas fa-phone-alt"></i></span>
                                    </div>
                                    <div class="cta__content">
                                        <p>Appelez-nous :</p>
                                        <span><a href="tel:<%= helpers.telHref(settings.phone) %>"><%= settings.phone %></a></span>
                                    </div>
                                </li>
                                <li>
                                    <div class="cta__icon">
                                        <span><i class="fas fa-envelope"></i></span>
                                    </div>
                                    <div class="cta__content">
                                        <p>Écrivez-nous :</p>
                                        <span><a href="mailto:<%= settings.email %>"><%= settings.email %></a></span>
                                    </div>
                                </li>
                                <li>
                                    <div class="cta__icon">
                                        <span><i class="fas fa-clock"></i></span>
                                    </div>
                                    <div class="cta__content">
                                        <p>Horaires</p>
                                        <span><%= settings.hours %></span>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-3 d-none d-lg-block">
                        <div class="grb__social f-right st-1">
                            <ul>
                                <%- include('social-items', { variant: 'header' }) %>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="header__main header-sticky header-main-1">
            <div class="container">
                <div class="row">
                    <div class="col-xl-2 col-lg-3 col-8">
                        <div class="logo">
                            <div class="logo-bg-1">
                                <img src="/assets/front/img/shape/logo-bg-1.png" alt="">
                            </div>
                            <a class="logo-text-white" href="/">
								<img src="/assets/custom/img/logo/logoh.png" alt="Kolokolo">
							</a>
                            <a class="logo-text-black" href="/">
								<img src="/assets/custom/img/logo/logoh.png" alt="Kolokolo">
							</a>
                        </div>
                    </div>
                    <div class="col-xl-10 col-lg-9 col-4">
                        <div class="header__menu-area f-right" style="width: 96% !important;">
                            <div class="menu-bg-1">
                                <img src="/assets/front/img/shape/menu-bg-1.png" alt="">
                            </div>
                            <div class="main-menu main-menu-1">
                                <nav id="mobile-menu">
                                    <ul>
                                        <li><a href="/">Accueil</a></li>
                                        <li><a href="/a-propos">À propos</a></li>
                                        <li><a href="/services">Services</a></li>
                                        <li><a href="/blog">Blog</a></li>
										<li><a href="/carriere">Carrière</a></li>
                                        <li><a href="/contact">Contact</a></li>
                                    </ul>
                                </nav>
                            </div>
                            <div class="header__search">
                                <a class="search-btn nav-search search-trigger d-none d-sm-inline-block" href="#"><i
                                        class="fal fa-search"></i></a>
                                <a class="side-toggle d-lg-none" href="javascript:void(0)"><i
                                        class="fal fa-bars"></i></a>
                            </div>
                            <div class="header__btn d-none d-xl-inline-block">
                                <a href="#devis" class="grb-btn" data-quote-open>Devis gratuit<i
                                        class="fas fa-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>
    <!-- header area end -->
    <!-- side toggle start  -->
    <div class="fix">
        <div class="side-info">
            <div class="side-info-content">
                <div class="offset-widget offset-logo mb-30 pb-20">
                    <div class="row align-items-center">
                        <div class="col-9"><a href="/"><img src="/assets/custom/img/logo/logoh.png" alt="Kolokolo" style="width: 170px;"></a>
                        </div>
                        <div class="col-3 text-end"><button class="side-info-close"><i
                                    class="fal fa-times"></i></button>
                        </div>
                    </div>
                </div>
                <div class="mobile-menu d-lg-none"></div>
                <div class="offset-widget offset_searchbar mb-30">
                    <form method="get" action="#">
                        <div class="offset_search_content">
                            <input type="search" placeholder="Que recherchez-vous ?">
                            <button type="submit" class="offset_search_button"><i class="fal fa-search"></i></button>
                        </div>
                    </form>
                </div>

                <div class="offset-widget mb-40 d-none d-lg-block">
                    <div class="info-widget">
                        <p class="mb-30">Agence digitale basée à Dakar. Sites web, applications mobiles, publicité et social media : on mène vos projets digitaux dans les meilleurs délais.</p>
                    </div>
                </div>

                <div class="row side-gallery gx-4">
                    <div class="col-4 mb-20">
                        <div class="side-image">
                            <a class="popup-image" href="/assets/front/img/portfolio/pm1.jpg"><img
                                    src="/assets/front/img/portfolio/pm1.jpg" alt="sidebar-img"></a>
                        </div>
                    </div>
                    <div class="col-4 mb-20">
                        <div class="side-image">
                            <a class="popup-image" href="/assets/front/img/portfolio/pm2.jpg"><img
                                    src="/assets/front/img/portfolio/pm2.jpg" alt="sidebar-img"></a>
                        </div>
                    </div>
                    <div class="col-4 mb-20">
                        <div class="side-image">
                            <a class="popup-image" href="/assets/front/img/portfolio/pm3.jpg"><img
                                    src="/assets/front/img/portfolio/pm3.jpg" alt="sidebar-img"></a>
                        </div>
                    </div>
                    <div class="col-4 mb-20">
                        <div class="side-image">
                            <a class="popup-image" href="/assets/front/img/portfolio/pm4.jpg"><img
                                    src="/assets/front/img/portfolio/pm4.jpg" alt="sidebar-img"></a>
                        </div>
                    </div>
                    <div class="col-4 mb-20">
                        <div class="side-image">
                            <a class="popup-image" href="/assets/front/img/portfolio/pm5.jpg"><img
                                    src="/assets/front/img/portfolio/pm5.jpg" alt="sidebar-img"></a>
                        </div>
                    </div>
                    <div class="col-4 mb-20">
                        <div class="side-image">
                            <a class="popup-image" href="/assets/front/img/portfolio/pm6.jpg"><img
                                    src="/assets/front/img/portfolio/pm6.jpg" alt="sidebar-img"></a>
                        </div>
                    </div>
                </div>

                <div class="side-map mt-20 mb-30 d-none d-lg-block">
                    <iframe src="<%= settings.map_embed %>"></iframe>
                </div>



                <div class="contact-infos mt-30 mb-30">
                    <div class="contact-list mb-30">
                        <h4>Contact</h4>
                        <a href="#" class="">
                            <i class="fal fa-map-marker-alt"></i>
                            <span><%= settings.location %></span>
                        </a>
                        <a href="tel:<%= helpers.telHref(settings.phone) %>" class="">
                            <i class="fal fa-phone"></i>
                            <span><%= settings.phone %></span>
                        </a>
                        <a href="mailto:<%= settings.email %>" class="">
                            <i class="far fa-envelope"></i>
                            <span><%= settings.email %></span>
                        </a>

                    </div>
                    <div class="grb__social footer-social offset-social">
                        <ul>
                            <%- include('social-items') %>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="offcanvas-overlay"></div>
    <!-- side toggle end -->
    <!-- Fullscreen search -->
    <div class="search-wrap">
        <div class="search-inner">
            <i class="fal fa-times search-close" id="search-close"></i>
            <div class="search-cell">
                <form method="get">
                    <div class="search-field-holder">
                        <input type="search" class="main-search-input" placeholder="Rechercher...">
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- end fullscreen search -->

