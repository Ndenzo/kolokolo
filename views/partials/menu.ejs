    <!-- header area start  -->
    <header>
        <div class="header__top d-none d-lg-block">
            <div class="container">
                <div class="row d-flex align-items-center">
                    <div class="col-md-7 col-lg-8">
                        <div class="grb__cta header-cta">
                            <ul>
                                <li>
                                    <div class="cta__icon">
                                        <span><i class="fas fa-phone-alt"></i></span>
                                    </div>
                                    <div class="cta__content">
                                        <p><%= t('header.call') %></p>
                                        <span><a href="tel:<%= helpers.telHref(settings.phone) %>"><%= settings.phone %></a></span>
                                    </div>
                                </li>
                                <li>
                                    <div class="cta__icon">
                                        <span><i class="fas fa-envelope"></i></span>
                                    </div>
                                    <div class="cta__content">
                                        <p><%= t('header.write') %></p>
                                        <span><a href="mailto:<%= settings.email %>"><%= settings.email %></a></span>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-5 col-lg-4 d-none d-md-flex align-items-center justify-content-end">
                        <div class="header-top-tools">
                            <%- include('lang-switch', { variant: 'dark' }) %>
                            <%- include('social-items', { variant: 'header', wrapClass: 'grb__social st-1' }) %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="header__main header-sticky header-main-1">
            <div class="container">
                <div class="row">
                    <div class="col-xl-2 col-lg-3 col-8">
                        <div class="logo">
                            <div class="logo-bg-1">
                                <img src="/assets/front/img/shape/logo-bg-1.png" alt="">
                            </div>
                            <a class="logo-text-white" href="/">
								<img src="/assets/custom/img/logo/logoh.png" alt="Kolokolo">
							</a>
                            <a class="logo-text-black" href="/" aria-hidden="true" tabindex="-1">
								<img src="/assets/custom/img/logo/logoh.png" alt="">
							</a>
                        </div>
                    </div>
                    <div class="col-xl-10 col-lg-9 col-4">
                        <div class="header__menu-area f-right">
                            <div class="menu-bg-1">
                                <img src="/assets/front/img/shape/menu-bg-1.png" alt="">
                            </div>
                            <div class="main-menu main-menu-1">
                                <nav id="mobile-menu">
                                    <ul>
                                        <li><a href="/"><%= t('nav.home') %></a></li>
                                        <li><a href="/a-propos"><%= t('nav.about') %></a></li>
                                        <li><a href="/services"><%= t('nav.services') %></a></li>
                                        <% if (features.career) { %><li><a href="/carriere"><%= t('nav.career') %></a></li><% } %>
                                        <li><a href="/contact"><%= t('nav.contact') %></a></li>
                                    </ul>
                                </nav>
                            </div>
                            <div class="header__search">
                                <a class="search-btn nav-search search-trigger d-none d-lg-inline-block" href="#" role="button" aria-label="<%= t('nav.search') %>"><i
                                        class="fal fa-search" aria-hidden="true"></i></a>
                                <a class="side-toggle d-lg-none" href="#" role="button" aria-label="Menu"><i
                                        class="fal fa-bars" aria-hidden="true"></i></a>
                            </div>
                            <div class="header__theme d-none">
                                <%- include('theme-switch') %>
                            </div>
                            <div class="header__btn d-none d-xl-inline-block">
                                <a href="#devis" class="grb-btn" data-quote-open><%= t('nav.quote') %><i
                                        class="fas fa-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>
    <!-- header area end -->
    <!-- side toggle start  -->
    <div class="side-info-wrap">
        <div class="side-info">
            <div class="side-info-content">
                <div class="offset-widget offset-logo mb-30 pb-20">
                    <div class="row align-items-center">
                        <div class="col-9"><a href="/"><img src="/assets/custom/img/logo/logoh.png" alt="Kolokolo" style="width: 170px;"></a>
                        </div>
                        <div class="col-3 text-end"><button class="side-info-close" type="button" aria-label="<%= lang === 'en' ? 'Close' : 'Fermer' %>"><i
                                    class="fal fa-times" aria-hidden="true"></i></button>
                        </div>
                    </div>
                </div>
                <div class="header__lang-slot is-drawer d-lg-none mb-25">
                    <%- include('lang-switch', { variant: 'dark' }) %>
                </div>
                <div class="header__theme-slot is-drawer d-none mb-25">
                    <%- include('theme-switch', { variant: 'dark' }) %>
                </div>
                <div class="mobile-menu d-lg-none"></div>
                <div class="offset-widget offset_searchbar mb-30">
                    <form method="get" action="/" data-side-search>
                        <div class="offset_search_content">
                            <input type="search" name="q" placeholder="<%= t('nav.searchSidebar') %>" aria-label="<%= t('nav.search') %>">
                            <button type="submit" class="offset_search_button" aria-label="<%= t('nav.search') %>"><i class="fal fa-search" aria-hidden="true"></i></button>
                        </div>
                    </form>
                </div>

                <div class="offset-widget mb-40 d-none d-lg-block">
                    <div class="info-widget">
                        <p class="mb-30"><%= t('header.sideIntro') %></p>
                    </div>
                </div>
                

                <div class="side-map mt-20 mb-30 d-none d-lg-block">
                    <iframe src="<%= settings.map_embed %>"></iframe>
                </div>



                <div class="contact-infos mt-30 mb-30">
                    <div class="contact-list mb-30">
                        <h4><%= t('footer.contact') %></h4>
                        <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent([settings.place.address, settings.place.regionCountry].filter(Boolean).join(', ')) %>" class="contact-address-link" target="_blank" rel="noopener noreferrer">
                            <i class="fal fa-map-marker-alt"></i>
                            <span><%= settings.place.address %>, <%= settings.place.regionCountry %></span>
                        </a>
                        <a href="tel:<%= helpers.telHref(settings.phone) %>" class="">
                            <i class="fal fa-phone"></i>
                            <span><%= settings.phone %></span>
                        </a>
                        <a href="mailto:<%= settings.email %>" class="">
                            <i class="far fa-envelope"></i>
                            <span><%= settings.email %></span>
                        </a>

                    </div>
                    <%- include('social-items', { wrapClass: 'grb__social footer-social offset-social' }) %>
                </div>
            </div>
        </div>
    </div>
    <div class="offcanvas-overlay"></div>
    <!-- side toggle end -->
    <!-- Fullscreen search -->
    <div class="search-wrap">
        <div class="search-inner">
            <i class="fal fa-times search-close" id="search-close"></i>
            <div class="search-cell">
                <form method="get" action="/" class="site-search-form" data-site-search>
                    <div class="search-field-holder">
                        <label class="sr-only" for="site-search-input"><%= t('nav.search') %></label>
                        <input id="site-search-input" type="search" name="q" class="main-search-input" placeholder="<%= t('nav.searchPlaceholder') %>" autocomplete="off" maxlength="120">
                    </div>
                    <div class="search-suggest" data-search-suggest hidden></div>
                </form>
            </div>
        </div>
    </div>
    <!-- end fullscreen search -->

