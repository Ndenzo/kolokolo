<div class="newsletter-area">
	<div class="container">
		<div class="row wow fadeInUp align-items-center">
			<div class="col-lg-6">
				<div class="newsletter-text mb-30">
					<h4><%= t('newsletter.title') %></h4>
					<p><%= t('newsletter.text') %></p>
				</div>
			</div>
			<div class="col-lg-6">
				<form class="subscribe-form mb-30" action="/newsletter" method="post" data-newsletter-form novalidate><input type="hidden" name="_csrf" value="<%= csrfToken %>">
					<input type="text" name="website" tabindex="-1" autocomplete="off" class="quote-hp" aria-hidden="true">
					<label class="sr-only" for="newsletter-email"><%= t('newsletter.email') %></label>
					<input id="newsletter-email" type="email" name="email" required maxlength="180" autocomplete="email" placeholder="<%= t('newsletter.placeholder') %>">
					<button type="submit">
						<span class="newsletter-btn-idle"><i class="fas fa-paper-plane"></i><%= t('newsletter.submit') %></span>
						<span class="newsletter-btn-busy" hidden><%= t('newsletter.busy') %></span>
					</button>
					<p class="subscribe-form-error" data-newsletter-error hidden></p>
					<p class="subscribe-form-ok" data-newsletter-success hidden><%= t('newsletter.ok') %></p>
				</form>
			</div>
		</div>
	</div>
</div>
