<div class="quote-modal" id="quote-modal" hidden>
	<div class="quote-modal-backdrop" data-quote-close></div>
	<div class="quote-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="quote-modal-title">
		<button class="quote-modal-close" type="button" data-quote-close aria-label="<%= t('quote.close') %>"><i class="fal fa-times"></i></button>
		<div class="quote-modal-intro">
			<p class="quote-kicker"><%= t('quote.kicker') %></p>
			<h2 id="quote-modal-title"><%= t('quote.title') %></h2>
			<p><%= t('quote.lead') %></p>
		</div>
		<form class="quote-form" id="quote-form" action="/devis" method="post" novalidate>
			<input type="text" name="website" tabindex="-1" autocomplete="off" class="quote-hp" aria-hidden="true">
			<input type="hidden" name="offer" id="quote-offer" value="">
			<div class="quote-grid">
				<section class="quote-pane">
					<h3><span>01</span> <%= t('quote.info') %></h3>
					<div class="quote-fields">
						<label>
							<span><%= t('contact.firstName') %> <abbr class="req" title="<%= t('contact.required') %>">*</abbr></span>
							<input type="text" name="firstname" required maxlength="120" autocomplete="given-name" placeholder="Aminata">
						</label>
						<label>
							<span><%= t('contact.lastName') %> <abbr class="req" title="<%= t('contact.required') %>">*</abbr></span>
							<input type="text" name="lastname" required maxlength="120" autocomplete="family-name" placeholder="Sow">
						</label>
						<label>
							<span><%= t('contact.email') %> <abbr class="req" title="<%= t('contact.required') %>">*</abbr></span>
							<input type="email" name="email" required maxlength="180" autocomplete="email" placeholder="vous@entreprise.sn">
						</label>
						<label>
							<span><%= t('contact.phone') %> <abbr class="req" title="<%= t('contact.required') %>">*</abbr></span>
							<input type="tel" name="phone" required maxlength="80" autocomplete="tel" placeholder="+221 77 000 00 00">
						</label>
						<label class="quote-full">
							<span><%= t('contact.company') %></span>
							<input type="text" name="company" maxlength="180" autocomplete="organization" placeholder="<%= t('contact.companyPh') %>">
						</label>
					</div>
				</section>
				<section class="quote-pane">
					<h3><span>02</span> <%= t('quote.wanted') %> <abbr class="req" title="<%= t('contact.required') %>">*</abbr></h3>
					<div class="quote-services">
						<% (typeof quoteServices !== 'undefined' ? quoteServices : []).forEach((service) => { %>
							<label class="quote-switch">
								<input type="checkbox" name="services" value="<%= service.label %>">
								<span class="quote-switch-track"><span class="quote-switch-thumb"></span></span>
								<span class="quote-switch-label"><%= t('services.names', service.label) %></span>
							</label>
						<% }) %>
					</div>
					<div class="quote-fields quote-fields-2">
						<label>
							<span><%= t('quote.budget') %></span>
							<select name="budget">
								<option value=""><%= t('quote.choose') %></option>
								<% (typeof quoteBudgets !== 'undefined' ? quoteBudgets : []).forEach((item) => { %>
									<option value="<%= item %>"><%= t('quote.budgets', item) %></option>
								<% }) %>
							</select>
						</label>
						<label>
							<span><%= t('quote.timeline') %></span>
							<select name="timeline">
								<option value=""><%= t('quote.choose') %></option>
								<% (typeof quoteTimelines !== 'undefined' ? quoteTimelines : []).forEach((item) => { %>
									<option value="<%= item %>"><%= t('quote.timelines', item) %></option>
								<% }) %>
							</select>
						</label>
					</div>
				</section>
			</div>
			<section class="quote-pane quote-pane-wide">
				<h3><span>03</span> <%= t('quote.describe') %> <abbr class="req" title="<%= t('contact.required') %>">*</abbr></h3>
				<textarea name="message" rows="5" required maxlength="4000" placeholder="<%= t('quote.messagePh') %>"></textarea>
			</section>
			<p class="quote-form-error" data-quote-error hidden></p>
			<div class="quote-actions">
				<button class="quote-btn quote-btn-ghost" type="button" data-quote-close>
					<i class="fal fa-times"></i>
					<span><%= t('quote.cancel') %></span>
				</button>
				<button class="quote-btn quote-btn-primary quote-submit" type="submit">
					<span class="quote-btn-idle"><i class="fas fa-paper-plane"></i> <%= t('quote.send') %></span>
					<span class="quote-btn-busy" hidden><i class="fas fa-spinner fa-spin"></i> <%= t('quote.sending') %></span>
				</button>
			</div>
		</form>
		<div class="quote-success" data-quote-success hidden>
			<div class="quote-success-icon"><i class="fas fa-check"></i></div>
			<h3><%= t('quote.sentTitle') %></h3>
			<p><%= t('quote.sentText') %></p>
			<button class="quote-btn quote-btn-primary" type="button" data-quote-close>
				<i class="fas fa-check"></i>
				<span><%= t('quote.close') %></span>
			</button>
		</div>
	</div>
</div>
