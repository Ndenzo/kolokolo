<%
	const s = typeof settings !== 'undefined' ? settings : {};
	const isHeader = typeof variant !== 'undefined' && variant === 'header';
	const wrap = typeof wrapClass !== 'undefined' ? wrapClass : '';
	const items = [
		{ key: 'facebook', icon: 'fab fa-facebook-f', cls: 'fb' },
		{ key: 'twitter', icon: 'fab fa-x-twitter', cls: 'twt' },
		{ key: 'instagram', icon: 'fab fa-instagram', cls: 'insta' },
		{ key: 'linkedin', icon: 'fab fa-linkedin', cls: 'pint' },
	].map((item) => ({ ...item, url: String(s[item.key] || '').trim() }))
		.filter((item) => item.url && item.url !== '#');
%>
<% if (items.length) { %>
<% if (wrap) { %><div class="<%= wrap %>"><% } %>
<ul>
<% items.forEach((item) => { %>
	<li><a<%- isHeader ? ` class="${item.cls}"` : '' %> href="<%= item.url %>" target="_blank" rel="noopener noreferrer"><i class="<%= item.icon %>"></i></a></li>
<% }) %>
</ul>
<% if (wrap) { %></div><% } %>
<% } %>
