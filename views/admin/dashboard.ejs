<%- include('partials/shell-start') %>
<%
	const hour = new Date().getHours();
	const greeting = hour < 12 ? 'Bonjour' : (hour < 18 ? 'Bon après-midi' : 'Bonsoir');
	const dateLabel = new Date().toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
	const pct = (active, total) => total ? Math.round((active / total) * 100) : 0;
	const contentModules = [
		{ href: '/admin/blog', icon: 'fa-newspaper', title: 'Blog', total: stats.posts, active: stats.activePosts, onLabel: 'visibles', offLabel: 'masqués', ratioLabel: 'en ligne' },
		{ href: '/admin/portfolio', icon: 'fa-project-diagram', title: 'Portfolio', total: stats.projects, active: stats.activeProjects, onLabel: 'visibles', offLabel: 'masqués', ratioLabel: 'en ligne' },
		{ href: '/admin/testimonials', icon: 'fa-quote-right', title: 'Témoignages', total: stats.testimonials, active: stats.activeTestimonials, onLabel: 'visibles', offLabel: 'masqués', ratioLabel: 'en ligne' },
		{ href: '/admin/clients', icon: 'fa-handshake', title: 'Logos clients', total: stats.clientLogos, active: stats.activeClientLogos, onLabel: 'visibles', offLabel: 'masqués', ratioLabel: 'en ligne' },
	];
	const otherModules = [
		{ href: '/admin/quotes', icon: 'fa-clipboard-list', title: 'Devis', total: stats.quotes, active: stats.quotes - stats.newQuotes, onLabel: 'pris en charge', offLabel: 'nouveaux', ratioLabel: 'traités' },
		{ href: '/admin/contacts', icon: 'fa-envelope', title: 'Messages', total: stats.contacts, active: stats.contacts - stats.newContacts, onLabel: 'pris en charge', offLabel: 'nouveaux', ratioLabel: 'traités' },
		{ href: '/admin/newsletter', icon: 'fa-paper-plane', title: 'Newsletter', total: stats.subscribers, active: stats.activeSubscribers, onLabel: 'inscrits', offLabel: 'désinscrits', ratioLabel: 'inscrits' },
		{ href: '/admin/jobs', icon: 'fa-briefcase', title: 'Carrières', total: stats.jobs, active: stats.activeJobs, onLabel: 'visibles', offLabel: 'masqués', ratioLabel: 'en ligne' },
	];
	const socials = [
		{ key: 'facebook', label: 'Facebook', icon: 'fab fa-facebook-f', url: settings.facebook },
		{ key: 'twitter', label: 'X', icon: 'fab fa-x-twitter', url: settings.twitter },
		{ key: 'instagram', label: 'Instagram', icon: 'fab fa-instagram', url: settings.instagram },
		{ key: 'linkedin', label: 'LinkedIn', icon: 'fab fa-linkedin-in', url: settings.linkedin },
	];
%>
<div class="admin-header">
	<div>
		<p class="page-kicker">Tableau de bord</p>
		<h1><%= greeting %></h1>
		<p>Vue d’ensemble du contenu publié sur le site — <%= dateLabel %>.</p>
	</div>
	<a class="btn btn-ghost" href="/" target="_blank"><i class="fas fa-external-link-alt"></i> Voir le site</a>
</div>

<section class="dash-hero">
	<div class="dash-hero-copy">
		<p class="dash-hero-kicker">Kolokolo CMS</p>
		<h2>Tout est prêt pour publier.</h2>
		<p>Gérez les pages vitrines, le blog, le portfolio et les offres depuis un espace unique.</p>
	</div>
	<div class="dash-hero-stats">
		<div>
			<strong><%= stats.activePosts + stats.activeProjects + stats.activeTestimonials + stats.activeJobs + stats.activeClientLogos %></strong>
			<span>éléments visibles</span>
		</div>
		<div>
			<strong><%= stats.posts + stats.projects + stats.testimonials + stats.jobs + stats.clientLogos %></strong>
			<span>contenus au total</span>
		</div>
	</div>
</section>

<section class="module-section">
	<div class="module-section-head">
		<span class="module-section-tag is-content">Contenu</span>
		<h2>Contenu du site</h2>
	</div>
	<div class="module-grid">
		<% contentModules.forEach((mod) => { const ratio = pct(mod.active, mod.total); %>
			<a class="module-card is-content" href="<%= mod.href %>">
				<div class="module-card-top">
					<span class="stat-icon"><i class="fas <%= mod.icon %>"></i></span>
					<span class="module-count"><%= mod.total %></span>
				</div>
				<h3><%= mod.title %></h3>
				<p><%= mod.active %> <%= mod.onLabel %> · <%= mod.total - mod.active %> <%= mod.offLabel %></p>
				<div class="progress" role="img" aria-label="<%= ratio %>% <%= mod.ratioLabel %>">
					<span style="width: <%= ratio %>%"></span>
				</div>
				<small><%= ratio %>% <%= mod.ratioLabel %></small>
			</a>
		<% }) %>
	</div>
</section>

<section class="module-section">
	<div class="module-section-head">
		<span class="module-section-tag is-ops">Activité</span>
		<h2>Demandes & communication</h2>
	</div>
	<div class="module-grid">
		<% otherModules.forEach((mod) => { const ratio = pct(mod.active, mod.total); %>
			<a class="module-card is-ops" href="<%= mod.href %>">
				<div class="module-card-top">
					<span class="stat-icon"><i class="fas <%= mod.icon %>"></i></span>
					<span class="module-count"><%= mod.total %></span>
				</div>
				<h3><%= mod.title %></h3>
				<p><%= mod.active %> <%= mod.onLabel %> · <%= mod.total - mod.active %> <%= mod.offLabel %></p>
				<div class="progress" role="img" aria-label="<%= ratio %>% <%= mod.ratioLabel %>">
					<span style="width: <%= ratio %>%"></span>
				</div>
				<small><%= ratio %>% <%= mod.ratioLabel %></small>
			</a>
		<% }) %>
	</div>
</section>

<div class="dash-layout">
	<div class="panel">
		<div class="panel-title">
			<h2>Actions rapides</h2>
		</div>
		<div class="quick-actions">
			<a class="quick-action" href="/admin/blog/new"><i class="fas fa-plus"></i><span>Nouvel article</span></a>
			<a class="quick-action" href="/admin/portfolio/new"><i class="fas fa-plus"></i><span>Nouveau projet</span></a>
			<a class="quick-action" href="/admin/testimonials/new"><i class="fas fa-plus"></i><span>Nouveau témoignage</span></a>
			<a class="quick-action" href="/admin/clients/new"><i class="fas fa-plus"></i><span>Nouveau logo client</span></a>
			<a class="quick-action" href="/admin/jobs/new"><i class="fas fa-plus"></i><span>Nouvelle offre</span></a>
			<a class="quick-action" href="/admin/newsletter/new"><i class="fas fa-plus"></i><span>Nouvelle newsletter</span></a>
		</div>
	</div>
	<div class="panel">
		<div class="panel-title">
			<h2>Coordonnées affichées</h2>
			<a href="/admin/settings">Modifier</a>
		</div>
		<div class="contact-tiles">
			<div class="contact-tile">
				<span class="contact-ico"><i class="fas fa-phone-alt"></i></span>
				<div><span>Téléphone</span><strong><%= settings.phone %></strong></div>
			</div>
			<div class="contact-tile">
				<span class="contact-ico"><i class="fas fa-envelope"></i></span>
				<div><span>Email</span><strong><%= settings.email %></strong></div>
			</div>
			<div class="contact-tile">
				<span class="contact-ico"><i class="fas fa-map-marker-alt"></i></span>
				<div><span>Adresse</span><strong><%= settings.place.address %></strong></div>
			</div>
			<div class="contact-tile">
				<span class="contact-ico"><i class="fas fa-globe-africa"></i></span>
				<div><span>Région, pays</span><strong><%= settings.place.regionCountry %></strong></div>
			</div>
			<div class="contact-tile">
				<span class="contact-ico"><i class="fas fa-clock"></i></span>
				<div><span>Horaires</span><strong><%= settings.hours %></strong></div>
			</div>
		</div>
		<div class="social-chips">
			<% socials.forEach((item) => { %>
				<% if (item.url) { %>
					<a class="social-chip is-on" href="<%= item.url %>" target="_blank" rel="noopener"><i class="<%= item.icon %>"></i> <%= item.label %></a>
				<% } else { %>
					<span class="social-chip"><i class="<%= item.icon %>"></i> <%= item.label %></span>
				<% } %>
			<% }) %>
		</div>
	</div>
</div>
<%- include('partials/shell-end') %>
