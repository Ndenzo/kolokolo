<%- include('../partials/shell-start') %>
<%
	const selectedCategory = post.category || '';
	const allCategories = Array.from(new Set([...(typeof categories !== 'undefined' ? categories : []), selectedCategory].filter(Boolean)));
%>
<div class="admin-header">
	<div>
		<p class="page-kicker">Blog</p>
		<h1><%= post.id ? 'Modifier l’article' : 'Nouvel article' %></h1>
		<p>La mise en forme du contenu est reproduite à l’identique sur le site.</p>
	</div>
</div>
<form action="<%= action %>" method="post" data-admin-form novalidate>
	<div class="form-grid">
		<div class="panel form-stack">
			<div class="field" data-field>
				<label class="admin-label" for="title">Titre <abbr class="req" title="Obligatoire">*</abbr></label>
				<input class="admin-input" id="title" name="title" value="<%= post.title %>" required data-validate="required">
				<p class="field-error" data-error></p>
			</div>
			<div class="field" data-field>
				<label class="admin-label" for="excerpt">Chapô (liste du blog)</label>
				<textarea class="admin-textarea" id="excerpt" name="excerpt"><%= post.excerpt || '' %></textarea>
				<p class="field-error" data-error></p>
			</div>
			<div>
				<label class="admin-label">Introduction</label>
				<textarea class="js-wysiwyg" name="intro_html"><%= post.intro_html || '' %></textarea>
			</div>
			<div class="stack-sm">
				<label class="admin-label">Citation (optionnelle)</label>
				<textarea class="admin-textarea" name="quote_text" placeholder="Texte de la citation"><%= post.quote_text || '' %></textarea>
				<input class="admin-input" name="quote_author" placeholder="Auteur" value="<%= post.quote_author || '' %>">
			</div>
			<div>
				<label class="admin-label">Texte à droite de l’image secondaire</label>
				<textarea class="js-wysiwyg" name="secondary_html"><%= post.secondary_html || '' %></textarea>
			</div>
			<div>
				<label class="admin-label">Suite de l’article</label>
				<textarea class="js-wysiwyg" name="body_html"><%= post.body_html || '' %></textarea>
			</div>
		</div>
		<div class="form-stack">
			<div class="panel form-stack">
				<label class="switch">
					<input type="checkbox" name="is_active" value="1" data-switch <%= helpers.isActive(post.is_active) ? 'checked' : '' %>>
					<span class="switch-track"><span class="switch-thumb"></span></span>
					<span>Visible sur le site</span>
					<span class="switch-state" data-switch-state></span>
				</label>
				<div class="field" data-field>
					<label class="admin-label" for="published_at">Date de publication</label>
					<input class="admin-input" id="published_at" type="datetime-local" name="published_at" value="<%= helpers.datetimeLocal(post.published_at) %>">
					<p class="field-error" data-error></p>
				</div>
				<div class="field" data-field>
					<label class="admin-label" for="category">Catégorie</label>
					<select class="admin-select" id="category" name="category" data-placeholder="Choisir une catégorie" data-allow-custom>
						<option value="">Choisir une catégorie</option>
						<% allCategories.forEach((category) => { %>
							<option value="<%= category %>" <%= category === selectedCategory ? 'selected' : '' %>><%= category %></option>
						<% }) %>
					</select>
					<p class="field-error" data-error></p>
				</div>
				<div class="field" data-field>
					<label class="admin-label" for="tags">Tags (séparés par des virgules)</label>
					<input class="admin-input" id="tags" name="tags" value="<%= post.tags || '' %>">
					<p class="field-error" data-error></p>
				</div>
			</div>
			<div class="panel">
				<label class="admin-label">Image de couverture</label>
				<div class="dropzone" data-dropzone>
					<input type="hidden" name="cover_image" value="<%= post.cover_image || '' %>">
					<input type="file" accept="image/*">
					<div data-preview></div>
					<div data-hint class="hint"><strong>Glissez une image</strong><br>ou cliquez pour parcourir</div>
					<button class="remove" type="button" data-remove hidden>Retirer</button>
				</div>
			</div>
			<div class="panel">
				<label class="admin-label">Image secondaire (colonne gauche)</label>
				<div class="dropzone" data-dropzone>
					<input type="hidden" name="secondary_image" value="<%= post.secondary_image || '' %>">
					<input type="file" accept="image/*">
					<div data-preview></div>
					<div data-hint class="hint"><strong>Glissez une image</strong><br>ou cliquez pour parcourir</div>
					<button class="remove" type="button" data-remove hidden>Retirer</button>
				</div>
			</div>
			<div class="form-actions">
				<a class="btn btn-ghost" href="/admin/blog">Annuler</a>
				<button class="btn btn-primary js-submit" type="submit">Enregistrer</button>
			</div>
		</div>
	</div>
</form>
<%- include('../partials/shell-end') %>
