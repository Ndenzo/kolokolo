<%- include('../../partials/shell-start') %>
<div class="admin-header">
	<div>
		<p class="page-kicker">Facturation</p>
		<h1>Factures</h1>
		<p>Une facture naît d’un devis accepté. Le statut indique si elle est soldée.</p>
	</div>
</div>
<div class="panel" data-table data-sort-index="5" data-sort-dir="desc">
	<% if (!invoices.length) { %>
		<div class="empty">
			<div class="empty-icon"><i class="fas fa-file-invoice-dollar"></i></div>
			<h3>Aucune facture</h3>
			<p>Transformez un devis pour créer la première facture.</p>
		</div>
	<% } else { %>
		<div class="table-toolbar">
			<div class="table-search">
				<i class="fas fa-search"></i>
				<input type="search" data-table-search placeholder="Rechercher" aria-label="Rechercher">
			</div>
			<div class="table-info" data-table-info></div>
		</div>
		<div class="table-wrap">
			<table class="table">
				<thead>
					<tr>
						<th data-sort>Numéro</th>
						<th data-sort>Client</th>
						<th data-sort>Total TTC</th>
						<th data-sort>Réglé</th>
						<th data-sort>Reste</th>
						<th data-sort data-sort-dir="desc">Date</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					<% invoices.forEach((item) => { %>
						<tr data-search="<%= item.number %> <%= item.customer_name %> <%= billingInvoiceStatus[item.status] %>">
							<td>
								<strong><%= item.number %></strong>
								<div><span class="badge badge-<%= item.status %>"><%= billingInvoiceStatus[item.status] || item.status %></span></div>
							</td>
							<td><%= item.customer_name %></td>
							<td><%= helpers.formatMoney(item.totals.ttc) %></td>
							<td><%= helpers.formatMoney(item.paid) %></td>
							<td><%= helpers.formatMoney(item.remaining) %></td>
							<td data-sort-value="<%= helpers.isoDate(item.issued_on) %>"><%= helpers.formatIsoDate(item.issued_on) %></td>
							<td>
								<div class="row-actions">
									<a class="btn-icon" href="/admin/billing/invoices/<%= item.id %>" title="Consulter"><i class="fas fa-eye"></i></a>
									<a class="btn-icon" href="/admin/billing/invoices/<%= item.id %>/pdf?v=<%= Date.now() %>" target="_blank" title="PDF"><i class="fas fa-file-pdf"></i></a>
								</div>
							</td>
						</tr>
					<% }) %>
				</tbody>
			</table>
		</div>
	<% } %>
</div>
<%- include('../../partials/shell-end') %>
