<%- include('../partials/shell-start') %>
<%
	const total = clients.length;
	const activeCount = clients.filter((item) => helpers.isActive(item.is_active)).length;
	const hiddenCount = total - activeCount;
%>
<div class="admin-header">
	<div>
		<p class="page-kicker">Logos clients</p>
		<h1>Logos clients</h1>
		<p>Chaque client a une version couleur (fonds clairs) et une version monochrome (logo blanc, fonds sombres).</p>
	</div>
	<a class="btn btn-primary" href="/admin/clients/new"><i class="fas fa-plus"></i> Nouveau logo</a>
</div>
<div class="stat-grid">
	<div class="stat-card">
		<div class="stat-icon"><i class="fas fa-handshake"></i></div>
		<div><span>Total</span><strong><%= total %></strong></div>
	</div>
	<div class="stat-card">
		<div class="stat-icon is-green"><i class="fas fa-eye"></i></div>
		<div><span>Visibles</span><strong><%= activeCount %></strong></div>
	</div>
	<div class="stat-card">
		<div class="stat-icon is-amber"><i class="fas fa-eye-slash"></i></div>
		<div><span>Masqués</span><strong><%= hiddenCount %></strong></div>
	</div>
</div>
<div class="panel" data-table>
	<% if (!total) { %>
		<div class="empty">
			<div class="empty-icon"><i class="fas fa-handshake"></i></div>
			<h3>Aucun logo client</h3>
			<p>Ajoutez un client pour l’afficher dans le bandeau partenaires une fois activé.</p>
		</div>
	<% } else { %>
		<div class="table-toolbar">
			<div class="table-search">
				<i class="fas fa-search"></i>
				<input type="search" data-table-search placeholder="Rechercher" aria-label="Rechercher">
			</div>
			<div class="table-info" data-table-info></div>
		</div>
		<div class="table-wrap">
			<table class="table">
				<thead>
					<tr>
						<th></th>
						<th></th>
						<th data-sort>Client</th>
						<th data-sort data-sort-dir="asc">Ordre</th>
						<th data-sort>Statut</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					<% clients.forEach((item) => { %>
						<tr data-search="<%= item.name %> <%= helpers.isActive(item.is_active) ? 'actif visible' : 'masqué inactif' %>">
							<td>
								<span class="table-thumb is-logo" title="Version couleur">
									<% if (item.logo_color) { %><img src="<%= item.logo_color %>" alt=""><% } %>
								</span>
							</td>
							<td>
								<span class="table-thumb is-logo is-dark" title="Version monochrome">
									<% if (item.logo_mono) { %><img src="<%= item.logo_mono %>" alt=""><% } %>
								</span>
							</td>
							<td><strong><%= item.name %></strong></td>
							<td data-sort-value="<%= item.sort_order %>"><%= item.sort_order %></td>
							<td data-sort-value="<%= helpers.isActive(item.is_active) ? '1' : '0' %>">
								<span class="badge <%= helpers.isActive(item.is_active) ? 'badge-on' : 'badge-off' %>">
									<span class="badge-dot"></span><%= helpers.isActive(item.is_active) ? 'Actif' : 'Masqué' %>
								</span>
							</td>
							<td>
								<div class="row-actions">
									<a class="btn-icon" href="/admin/clients/<%= item.id %>/edit" title="Modifier"><i class="fas fa-pen"></i></a>
									<form action="/admin/clients/<%= item.id %>/toggle" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
										<button class="btn-icon is-warn" type="submit" title="<%= helpers.isActive(item.is_active) ? 'Désactiver' : 'Activer' %>">
											<i class="fas <%= helpers.isActive(item.is_active) ? 'fa-eye-slash' : 'fa-eye' %>"></i>
										</button>
									</form>
									<form action="/admin/clients/<%= item.id %>/delete" method="post" data-confirm><input type="hidden" name="_csrf" value="<%= csrfToken %>">
										<button class="btn-icon is-danger" type="submit" title="Supprimer"><i class="fas fa-trash-alt"></i></button>
									</form>
								</div>
							</td>
						</tr>
					<% }) %>
				</tbody>
			</table>
		</div>
		<div class="table-empty" data-table-empty>Aucun résultat pour cette recherche.</div>
		<div class="table-footer">
			<label class="table-pagesize">
				Afficher
				<select data-page-size>
					<option value="10" selected>10</option>
					<option value="25">25</option>
					<option value="50">50</option>
				</select>
				lignes
			</label>
			<div class="pager" data-pager></div>
		</div>
	<% } %>
</div>
<%- include('../partials/shell-end') %>
