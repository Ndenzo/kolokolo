<%- include('../partials/shell-start') %>
<div class="admin-header">
	<div>
		<p class="page-kicker">Témoignages</p>
		<h1><%= item.id ? 'Modifier le témoignage' : 'Nouveau témoignage' %></h1>
		<p>Le texte saisi s’affiche tel quel dans les cartes témoignages du site.</p>
	</div>
</div>
<form class="form-grid" action="<%= action %>" method="post" data-admin-form novalidate>
	<div class="panel form-stack">
		<div class="field" data-field>
			<label class="admin-label" for="name">Nom du client <abbr class="req" title="Obligatoire">*</abbr></label>
			<input class="admin-input" id="name" name="name" value="<%= item.name %>" required data-validate="required">
			<p class="field-error" data-error></p>
		</div>
		<div class="field" data-field>
			<label class="admin-label" for="role">Fonction / entreprise</label>
			<input class="admin-input" id="role" name="role" value="<%= item.role || '' %>" placeholder="Fondateur, startup basée à Seattle">
			<p class="field-error" data-error></p>
		</div>
		<div class="field" data-field>
			<label class="admin-label" for="content">Témoignage <abbr class="req" title="Obligatoire">*</abbr></label>
			<textarea class="admin-textarea is-tall" id="content" name="content" required data-validate="required"><%= item.content || '' %></textarea>
			<p class="field-error" data-error></p>
		</div>
	</div>
	<div class="form-stack">
		<div class="panel form-stack">
			<label class="switch">
				<input type="checkbox" name="is_active" value="1" data-switch <%= helpers.isActive(item.is_active) ? 'checked' : '' %>>
				<span class="switch-track"><span class="switch-thumb"></span></span>
				<span>Visible sur le site</span>
				<span class="switch-state" data-switch-state></span>
			</label>
			<div class="field" data-field>
				<label class="admin-label" for="rating">Note <abbr class="req" title="Obligatoire">*</abbr></label>
				<select class="admin-select" id="rating" name="rating" data-placeholder="Choisir une note" required data-validate="required">
					<option value="">Choisir une note</option>
					<% [1, 2, 3, 4, 5].forEach((n) => { %>
						<option value="<%= n %>" <%= Number(item.rating || 5) === n ? 'selected' : '' %>><%= n %> / 5</option>
					<% }) %>
				</select>
				<p class="field-error" data-error></p>
			</div>
			<div class="field" data-field>
				<label class="admin-label" for="sort_order">Ordre d’affichage</label>
				<input class="admin-input" id="sort_order" type="number" name="sort_order" value="<%= item.sort_order || 0 %>">
				<p class="field-error" data-error></p>
			</div>
		</div>
		<div class="panel">
			<label class="admin-label">Photo</label>
			<div class="dropzone" data-dropzone>
				<input type="hidden" name="photo" value="<%= item.photo || '' %>">
				<input type="file" accept="image/*">
				<div data-preview></div>
				<div data-hint class="hint"><strong>Glissez une image</strong><br>ou cliquez pour parcourir</div>
				<button class="remove" type="button" data-remove hidden>Retirer</button>
			</div>
		</div>
		<div class="form-actions">
			<a class="btn btn-ghost" href="/admin/testimonials">Annuler</a>
			<button class="btn btn-primary js-submit" type="submit">Enregistrer</button>
		</div>
	</div>
</form>
<%- include('../partials/shell-end') %>
