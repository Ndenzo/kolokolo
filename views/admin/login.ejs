<!doctype html>
<html lang="fr">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title><%= title %></title>
	<meta name="robots" content="noindex, nofollow">
	<meta name="theme-color" content="#FF0A08">
	<link rel="icon" type="image/png" sizes="32x32" href="/assets/custom/img/logo/favicon.png">
	<link rel="apple-touch-icon" href="/assets/custom/img/logo/logo.png">
	<link rel="stylesheet" href="/assets/front/css/fontawesome-all.min.css">
	<link rel="stylesheet" href="/assets/admin/css/admin.css">
</head>
<body class="login-body">
	<div class="login-orbs" aria-hidden="true">
		<span class="orb orb-a"></span>
		<span class="orb orb-b"></span>
		<span class="orb orb-c"></span>
	</div>
	<div class="login-shell">
		<aside class="login-showcase">
			<div class="login-showcase-inner">
				<div class="login-logo-plate">
					<img src="/assets/custom/img/logo/logoh.png" alt="Kolokolo">
				</div>
				<p class="login-kicker">Espace de gestion</p>
				<h2>Pilotez tout le contenu du site depuis un seul endroit.</h2>
				<p class="login-lead">Articles, projets, témoignages, offres et coordonnées — publication, mise à jour et visibilité en quelques clics.</p>
				<ul class="login-points">
					<li><i class="fas fa-check-circle"></i> Mise en ligne instantanée</li>
					<li><i class="fas fa-layer-group"></i> Portfolio et carrières</li>
					<li><i class="fas fa-shield-alt"></i> Accès réservé à l’équipe</li>
				</ul>
			</div>
		</aside>
		<main class="login-panel">
			<form class="login-card" action="/auth" method="post" data-admin-form novalidate>
				<p class="login-card-kicker">Connexion</p>
				<h1>Bon retour</h1>
				<p class="lead">Identifiez-vous pour ouvrir le tableau de bord.</p>
				<% if (error) { %>
					<div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
				<% } %>
				<div class="field" data-field>
					<label class="admin-label" for="email">Email <abbr class="req" title="Obligatoire">*</abbr></label>
					<div class="login-input">
						<i class="fas fa-envelope"></i>
						<input id="email" type="email" name="email" value="<%= email %>" autocomplete="username" required data-validate="required email" placeholder="vous@kolokolo.sn">
					</div>
					<p class="field-error" data-error></p>
				</div>
				<div class="field" data-field>
					<label class="admin-label" for="password">Mot de passe <abbr class="req" title="Obligatoire">*</abbr></label>
					<div class="password-field login-input">
						<i class="fas fa-lock"></i>
						<input id="password" type="password" name="password" autocomplete="current-password" required data-validate="required" placeholder="••••••••">
						<button type="button" class="password-toggle" data-password-toggle aria-label="Afficher le mot de passe" aria-pressed="false">
							<i class="fas fa-eye"></i>
						</button>
					</div>
					<p class="field-error" data-error></p>
				</div>
				<button class="btn btn-primary btn-block login-submit js-submit" type="submit">
					<span>Se connecter</span>
					<i class="fas fa-arrow-right"></i>
				</button>
				<a class="login-back" href="/"><i class="fas fa-arrow-left"></i> Retourner sur le site</a>
			</form>
		</main>
	</div>
	<script src="/assets/admin/js/admin.js"></script>
</body>
</html>
