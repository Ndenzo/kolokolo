<!doctype html>
<html lang="fr">
<head>
	<meta name="csrf-token" content="<%= csrfToken %>">
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title><%= title %> - Kolokolo</title>
	<meta name="robots" content="noindex, nofollow">
	<meta name="theme-color" content="#FF0A08">
	<link rel="icon" type="image/png" sizes="32x32" href="/assets/custom/img/logo/favicon.png">
	<link rel="apple-touch-icon" href="/assets/custom/img/logo/logo.png">
	<link rel="stylesheet" href="/assets/front/css/fontawesome-all.min.css">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flag-icons@7.2.3/css/flag-icons.min.css">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
	<link rel="stylesheet" href="/assets/admin/css/admin.css">
</head>
<body class="admin-body">
	<div class="toast-stack">
		<% if (flash) { %>
			<div class="toast <%= flash.type === 'error' ? 'toast-error' : 'toast-success' %>" data-toast><%= flash.message %></div>
		<% } %>
	</div>
	<div class="admin-shell">
		<aside class="sidebar">
			<div class="sidebar-brand">
				<img src="/assets/custom/img/logo/logoh.png" alt="Kolokolo">
				<span>
					<small>Espace</small>
					CMS
				</span>
			</div>
			<nav class="nav-list">
				<%
					const contentActive = ['portfolio', 'testimonials', 'clients'].includes(active);
					const leadsActive = ['quotes', 'contacts'].includes(active);
					const mailActive = ['newsletter', 'emails'].includes(active);
				%>
				<a class="nav-item <%= active === 'dashboard' ? 'is-active' : '' %>" href="/admin"><i class="fas fa-th-large"></i><span>Tableau de bord</span></a>

				<div class="nav-group<%= contentActive ? ' is-open is-current' : '' %>" data-nav-group>
					<button class="nav-item nav-group-toggle" type="button" aria-expanded="<%= contentActive ? 'true' : 'false' %>">
						<i class="fas fa-layer-group"></i>
						<span>Contenu</span>
						<em class="nav-caret fas fa-chevron-down" aria-hidden="true"></em>
					</button>
					<div class="nav-group-panel"<%= contentActive ? '' : ' hidden' %>>
						<a class="nav-item nav-sub<%= active === 'portfolio' ? ' is-active' : '' %>" href="/admin/portfolio"><i class="fas fa-project-diagram"></i><span>Portfolio</span></a>
						<a class="nav-item nav-sub<%= active === 'testimonials' ? ' is-active' : '' %>" href="/admin/testimonials"><i class="fas fa-quote-right"></i><span>Témoignages</span></a>
						<a class="nav-item nav-sub<%= active === 'clients' ? ' is-active' : '' %>" href="/admin/clients"><i class="fas fa-handshake"></i><span>Logos clients</span></a>
					</div>
				</div>

				<div class="nav-group<%= leadsActive ? ' is-open is-current' : '' %>" data-nav-group>
					<button class="nav-item nav-group-toggle" type="button" aria-expanded="<%= leadsActive ? 'true' : 'false' %>">
						<i class="fas fa-inbox"></i>
						<span>Demandes</span>
						<em class="nav-caret fas fa-chevron-down" aria-hidden="true"></em>
					</button>
					<div class="nav-group-panel"<%= leadsActive ? '' : ' hidden' %>>
						<a class="nav-item nav-sub<%= active === 'quotes' ? ' is-active' : '' %>" href="/admin/quotes"><i class="fas fa-clipboard-list"></i><span>Devis</span></a>
						<a class="nav-item nav-sub<%= active === 'contacts' ? ' is-active' : '' %>" href="/admin/contacts"><i class="fas fa-envelope"></i><span>Messages</span></a>
					</div>
				</div>

				<div class="nav-group<%= mailActive ? ' is-open is-current' : '' %>" data-nav-group>
					<button class="nav-item nav-group-toggle" type="button" aria-expanded="<%= mailActive ? 'true' : 'false' %>">
						<i class="fas fa-bullhorn"></i>
						<span>Communication</span>
						<em class="nav-caret fas fa-chevron-down" aria-hidden="true"></em>
					</button>
					<div class="nav-group-panel"<%= mailActive ? '' : ' hidden' %>>
						<a class="nav-item nav-sub<%= active === 'newsletter' ? ' is-active' : '' %>" href="/admin/newsletter"><i class="fas fa-paper-plane"></i><span>Newsletter</span></a>
						<a class="nav-item nav-sub<%= active === 'emails' ? ' is-active' : '' %>" href="/admin/emails"><i class="fas fa-file-alt"></i><span>Modèles emails</span></a>
					</div>
				</div>

				<a class="nav-item <%= active === 'jobs' ? ' is-active' : '' %>" href="/admin/jobs"><i class="fas fa-briefcase"></i><span>Carrières</span></a>
				<a class="nav-item <%= active === 'settings' ? ' is-active' : '' %>" href="/admin/settings"><i class="fas fa-sliders-h"></i><span>Infos du site</span></a>
			</nav>
			<div class="sidebar-foot">
				<div class="sidebar-user">
					<span class="user-avatar"><%= currentUser && currentUser.email ? currentUser.email.charAt(0).toUpperCase() : 'K' %></span>
					<span class="user-meta">
						<small>Connecté</small>
						<%= currentUser ? currentUser.email : '' %>
					</span>
				</div>
				<form action="/auth/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
					<button class="btn btn-logout btn-block" type="submit"><i class="fas fa-sign-out-alt"></i> <span>Déconnexion</span></button>
				</form>
			</div>
		</aside>
		<main class="admin-main">
