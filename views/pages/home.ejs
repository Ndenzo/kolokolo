	<!-- about area start  -->
	<section class="about__area">
		<div class="container">
			<div class="row wow fadeInUp">
				<div class="col-xl-6 col-lg-5">
					<div class="about__img p-relative mb-30">
						<div class="about__img-inner">
							<img src="/assets/front/img/about/about.jpg" alt="">
						</div>
						<div class="p-element">
							<div class="ab-border d-none d-lg-block"></div>
							<div class="award">
								<img src="/assets/front/img/icon/batch.png" alt="">
								<p>Agence digitale à Dakar</p>
							</div>
							<div class="ab-image">
								<img src="/assets/front/img/about/abp-img.png" alt="">
							</div>
						</div>
					</div>
				</div>
				<div class="col-xl-6 col-lg-7">
					<div class="about__content mb-30">
						<div class="section-title mb-30">
							<div class="border-left">
								<p>#Kolokolo</p>
							</div>
							<h2>Qui sommes-nous ?</h2>
						</div>
						<p>Nous sommes une agence digitale basée à Dakar au Sénégal, spécialisée dans la conception et la réalisation de projets web. Web Apps ou Mobile App n'ont plus de secret pour nous. Nos process sont simples, pour que vos projets sur le digital soient menés à bien dans les meilleurs délais. Kolokolo, autre nom de l'ibis rouge qui est notre emblème, arbore son joli plumage pour donner des couleurs à tous vos projets digitaux.</p>
						<ul class="about-points">
							<li>
								<div class="points-heading">
									<div class="p-icon">
										<i class="flaticon-team"></i>
									</div>
									<h5>Garantie Qualité</h5>
								</div>
								<p>Nous mettons un point d'honneur à livrer un travail soigné et fiable, à la hauteur de vos attentes.</p>
							</li>
							<li>
								<div class="points-heading">
									<div class="p-icon">
										<i class="flaticon-creative-team"></i>
									</div>
									<h5>Innovation Permanente</h5>
								</div>
								<p>Nous restons à l'affût des dernières tendances digitales pour vous proposer des solutions modernes.</p>
							</li>
						</ul>
						<div class="about__btn st-1">
							<a href="#" class="grb-btn st-1">En savoir plus<i class="fas fa-arrow-right"></i></a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<!-- about area end -->
	<!-- service area start  -->
	<section class="service__area grey-bg pt-120 pb-90">
		<div class="container">
			<div class="row wow fadeInUp">
				<div class="col-lg-6">
					<div class="section-title mb-55">
						<div class="border-left">
							<p>Nos Services</p>
						</div>
						<h2>Nos Meilleurs Services</h2>
					</div>
				</div>
				<div class="col-lg-6">
					<div class="service__text mb-30">
						<p>Nous créons des sites web, des applications mobiles, de la publicité digitale et du social media marketing pour mener vos projets à bien dans les meilleurs délais.</p>
					</div>
				</div>
			</div>
			<%- include('../partials/services-grid') %>
		</div>
	</section>
	<!-- service area end -->
	<!-- choosing area start  -->
	<section class="choosing__area pt-120 pb-90">
