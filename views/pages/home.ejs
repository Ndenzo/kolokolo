<main>
	<!-- hero area start here -->
	<section class="slider-area p-relative fix">
		<div class="slider-active swiper-container">
               <div class="swiper-wrapper">
				<div class="single-slider slider-height swiper-slide slider-overlay" data-swiper-autoplay="5000">
					<div class="slide-bg" data-background="/assets/front/img/hero/banner1.webp"></div>
                         <div class="container">
						<div class="row">
                                   <div class="col-lg-9">
								<div class="hero-content">
									<div class="hero-bg-shape" data-animation="fadeInUp" data-delay=".3s">
										<div class="hero-s-1">
											<img src="/assets/front/img/shape/hero-s-1.png" alt="">
										</div>
										<!-- <div class="hero-s-2">
											<img src="/assets/front/img/shape/hero-s-2.png" alt="">
										</div> -->
									</div>
									<p data-animation="fadeInUp" data-delay=".6s"><%= t('home.slide1Kicker') %></p>
									<h1 class="hero-title" data-animation="fadeInUp" data-delay=".9s"><%= t('home.slide1Title') %></h1>
									<div class="hero-content-btn" data-animation="fadeInUp" data-delay="1.1s">
										<a href="#devis" class="grb-btn" data-quote-open><%= t('home.cta') %></a>
									</div>
                                        </div>
                                   </div>
                              </div>
                         </div>
                    </div>
				<div class="single-slider slider-height swiper-slide slider-overlay" data-swiper-autoplay="5000">
					<div class="slide-bg" data-background="/assets/front/img/hero/banner3.webp"></div>
                         <div class="container">
						<div class="row">
                                   <div class="col-lg-9">
								<div class="hero-content">
									<div class="hero-bg-shape" data-animation="fadeInUp" data-delay=".3s">
										<div class="hero-s-1">
											<img src="/assets/front/img/shape/hero-s-1.png" alt="">
										</div>
										<!-- <div class="hero-s-2">
											<img src="/assets/front/img/shape/hero-s-2.png" alt="">
										</div> -->
									</div>
									<p data-animation="fadeInUp" data-delay=".6s"><%= t('home.slide2Kicker') %></p>
									<h2 class="hero-title" data-animation="fadeInUp" data-delay=".9s"><%= t('home.slide2Title') %></h2>
									<div class="hero-content-btn" data-animation="fadeInUp" data-delay="1.1s">
										<a href="#devis" class="grb-btn" data-quote-open><%= t('home.cta') %></a>
									</div>
                                        </div>
                                   </div>
                              </div>
                         </div>
                    </div>
				<div class="single-slider slider-height swiper-slide slider-overlay" data-swiper-autoplay="5000">
					<div class="slide-bg" data-background="/assets/front/img/hero/banner2.webp"></div>
                         <div class="container">
						<div class="row">
                                   <div class="col-lg-9">
								<div class="hero-content">
									<div class="hero-bg-shape" data-animation="fadeInUp" data-delay=".3s">
										<div class="hero-s-1">
											<img src="/assets/front/img/shape/hero-s-1.png" alt="">
										</div>
										<!-- <div class="hero-s-2">
											<img src="/assets/front/img/shape/hero-s-2.png" alt="">
										</div> -->
									</div>
									<p data-animation="fadeInUp" data-delay=".6s"><%= t('home.slide3Kicker') %></p>
									<h2 class="hero-title" data-animation="fadeInUp" data-delay=".9s"><%= t('home.slide3Title') %></h2>
									<div class="hero-content-btn" data-animation="fadeInUp" data-delay="1.1s">
										<a href="#devis" class="grb-btn" data-quote-open><%= t('home.cta') %></a>
									</div>
                                        </div>
                                   </div>
                              </div>
                         </div>
                    </div>
               </div>
               <!-- If we need navigation buttons -->
               <div class="slider-nav">
                    <div class="swiper-button-prev"><i class="far fa-arrow-left"></i></div>
                    <div class="swiper-button-next"><i class="far fa-arrow-right"></i></div>
               </div>
          </div>
     </section>
	<!-- hero area end here -->
	<%- include('../partials/client-logos-slider', { extraClass: 'grey-bg' }) %>
	<!-- about area start  -->
	<section class="about__area">
		<div class="container">
			<div class="row align-items-center wow fadeInUp">
				<div class="col-xl-6 col-lg-5">
					<div class="about__img p-relative mb-30">
						<div class="about__img-inner">
							<img src="/assets/front/img/about/about.jpg" alt="<%= t('home.aboutImgAlt') %>" loading="lazy">
						</div>
						<div class="p-element">
							<div class="ab-border d-none d-lg-block"></div>
							<div class="ab-image">
								<img src="/assets/front/img/about/abp-img.jpg" alt="<%= t('home.aboutImg2Alt') %>" loading="lazy">
							</div>
						</div>
					</div>
				</div>
				<div class="col-xl-6 col-lg-7">
					<div class="about__content mb-30">
						<div class="section-title">
							<div class="border-left">
								<p>#Kolokolo</p>
							</div>
							<h2><%= t('home.who') %></h2>
						</div>
						<p><%= t('home.about') %></p>
						<p class="about__extra"><%= t('home.aboutExtra') %></p>
						<ul class="about__highlights">
							<li><%= t('home.aboutPoint1') %></li>
							<li><%= t('home.aboutPoint2') %></li>
							<li><%= t('home.aboutPoint3') %></li>
						</ul>
						<div class="about__btn st-1">
							<a href="/a-propos" class="grb-btn st-1"><%= t('home.more') %><i class="fas fa-arrow-right"></i></a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<!-- about area end -->
	<!-- service area start  -->
	<section class="service__area grey-bg pt-120 pb-90">
		<div class="container">
			<div class="row wow fadeInUp">
				<div class="col-lg-6">
					<div class="section-title mb-55">
						<div class="border-left">
							<p><%= t('home.ourServices') %></p>
							</div>
							<h2><%= t('home.bestServices') %></h2>
					</div>
				</div>
				<div class="col-lg-6">
					<div class="service__text mb-30">
						<p><%= t('home.servicesLead') %></p>
					</div>
				</div>
			</div>
			<%- include('../partials/services-grid') %>
		</div>
	</section>
	<!-- service area end -->
	<!-- choosing area start  -->
	<section class="choosing__area pt-120 pb-90">
		<div class="container">
			<div class="row wow fadeInUp">
				<div class="col-lg-6">
					<div class="choosing__img mb-30">
						<img src="/assets/front/img/about/about1.webp" alt="<%= t('home.whyTitle') %>" loading="lazy">
					</div>
				</div>
				<div class="col-lg-6">
					<div class="section-title mb-55">
						<div class="border-left">
							<p><%= t('home.why') %></p>
						</div>
						<h2><%= t('home.whyTitle') %></h2>
					</div>
					<div class="choosing__information mb-30">
						<ul>
							<li>
								<div class="choosing__number">
									<span>01</span>
								</div>
								<div class="choosing__text">
									<h5><%= t('home.why1') %></h5>
									<p><%= t('home.why1Text') %></p>
								</div>
							</li>
							<li>
								<div class="choosing__number">
									<span>02</span>
								</div>
								<div class="choosing__text">
									<h5><%= t('home.why2') %></h5>
									<p><%= t('home.why2Text') %></p>
								</div>
							</li>
							<li>
								<div class="choosing__number">
									<span>03</span>
								</div>
								<div class="choosing__text">
									<h5><%= t('home.why3') %></h5>
									<p><%= t('home.why3Text') %></p>
								</div>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>
	<!-- choosing area end  -->
	<!-- testimonial area start  -->
	<% const homeTestimonials = typeof testimonials !== 'undefined' ? testimonials : []; %>
	<% /* Témoignages masqués temporairement */ if (false && homeTestimonials.length) { %>
	<section class="testimonial-area st-3 grey-bg">
		<div class="container">
			<div class="row wow fadeInUp">
				<div class="col-md-8">
					<div class="section-title mb-55">
						<div class="border-left">
							<p><%= t('home.testimonials') %></p>
						</div>
						<h2><%= t('home.testimonialsTitle') %> <br> <%= t('home.testimonialsTitle2') %></h2>
					</div>
				</div>
				<div class="col-md-4">
					<div class="testimonial-nav-3">
						<div class="testimonial-btn-prev"><i class="fal fa-angle-left"></i></div>
						<div class="testimonial-btn-next"><i class="fal fa-angle-right"></i></div>
					</div>
				</div>
			</div>
			<div class="row wow fadeInUp">
				<div class="col-lg-12">
					<div class="testimonial-wrapper p-relative">
						<div class="swiper-container testimonial-active-3 st-3">
							<div class="swiper-wrapper">
								<% homeTestimonials.forEach((item) => { %>
								<div class="swiper-slide">
									<div class="testimonial-single st-3 mb-50">
										<ul class="testimonial-review st-3">
											<% for (let s = 0; s < (item.rating || 5); s++) { %>
											<li><i class="fas fa-star"></i></li>
											<% } %>
										</ul>
										<p><%= item.content %></p>
										<div class="testimonial-img st-3">
											<img src="/assets/front/img/testimonial/avatar-anonymous.svg" alt="">
										</div>
										<div class="testimonial-name st-3">
											<h5><a href="#"><%= item.name %></a></h5>
											<p><%= item.role %></p>
										</div>
										<div class="testimonial-quote st-3">
											<i class="fal fa-quote-right"></i>
										</div>
									</div>
								</div>
								<% }) %>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<% } %>
	<% const homeProjects = typeof projects !== 'undefined' ? projects : []; %>
	<% if (homeProjects.length) { %>
	<section class="portfolio-area" id="portfolio">
		<div class="container">
			<div class="row wow fadeInUp align-items-center counter-head">
				<div class="col-lg-6 col-md-7">
					<div class="portfolio-left">
						<div class="section-title mb-55">
							<div class="border-left">
								<p><%= t('home.portfolio') %></p>
							</div>
							<h2><%= t('home.portfolioTitle') %></h2>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="portfolio-container">
			<div class="portfolio-inner">
				<div class="swiper-container portfolio-active">
					<div class="swiper-wrapper">
						<% homeProjects.forEach((project) => { %>
						<div class="swiper-slide">
							<div class="single-portfolio">
								<div class="portfolio-img">
									<a href="<%= project.link || '#' %>"<%- project.link ? ' target="_blank" rel="noopener noreferrer"' : '' %>><img src="<%= project.image || '/assets/front/img/portfolio/port1.jpg' %>" alt="<%= project.title %>" loading="lazy"></a>
								</div>
								<div class="portfolio-content">
									<h5><a href="<%= project.link || '#' %>"<%- project.link ? ' target="_blank" rel="noopener noreferrer"' : '' %>><%= project.title %></a></h5>
									<% if (project.category) { %><span><%= t('portfolioCategory', project.category) %></span><% } %>
									<a class="p-link popup-image" href="<%= project.image || '/assets/front/img/portfolio/port1.jpg' %>"><i class="fal fa-plus"></i></a>
								</div>
							</div>
						</div>
						<% }) %>
					</div>
					<div class="portfolio-nav">
						<div class="swiper-button-prev"><i class="far fa-arrow-left"></i></div>
						<div class="swiper-button-next"><i class="far fa-arrow-right"></i></div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<% } %>
	<!-- portfolio area end -->
	<!-- newsletter area start  -->
	<%- include('../partials/newsletter') %>
	<!-- newsletter area end -->
</main>
