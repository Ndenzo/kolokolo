<main>
	<section class="page-title-area" data-background="/assets/front/img/bg/hire-bg.jpg">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<div class="page-title-content text-center">
						<div class="page-title-heading">
							<h1>Blog</h1>
						</div>
						<nav class="grb-breadcrumb">
							<ol class="breadcrumb">
								<li class="breadcrumb-item"><a href="/">Accueil</a></li>
								<li class="breadcrumb-item active" aria-current="page">Blog</li>
							</ol>
						</nav>
					</div>
				</div>
			</div>
		</div>
	</section>
	<div class="blog-main-area pt-150">
		<div class="container">
			<div class="row wow fadeInUp">
				<div class="col-lg-8">
					<div class="blog-main">
						<% if (!posts.length) { %>
							<div class="blog-empty">
								<h3>Aucun article pour le moment</h3>
								<p>Revenez bientôt, nos contenus seront publiés ici dès qu’ils seront actifs.</p>
							</div>
						<% } %>
						<% posts.forEach((post) => { %>
							<div class="blog-main-single mb-60">
								<div class="bms-img mb-30">
									<a href="/blog/<%= post.slug %>"><img src="<%= helpers.coverFallback(post.cover_image) %>" alt="<%= post.title %>"></a>
								</div>
								<div class="bms-content">
									<div class="fix mb-30">
										<div class="blog-date bms-date">
											<i class="fal fa-calendar-alt"></i>
											<span><%= helpers.formatDay(post.published_at) %></span>
											<p><%= helpers.formatMonthYear(post.published_at) %></p>
										</div>
										<div class="bms-title">
											<ul class="project-like-view bms-lv">
												<% if (post.category) { %>
													<li><a href="/blog?category=<%= encodeURIComponent(post.category) %>"><i class="fas fa-folder-open"></i><%= post.category %></a></li>
												<% } %>
												<li><a href="/contact"><i class="fas fa-map-marker-alt"></i><%= settings.location %></a></li>
												<li><i class="fas fa-eye"></i><%= post.views %> vues</li>
											</ul>
											<h4><a href="/blog/<%= post.slug %>"><%= post.title %></a></h4>
										</div>
									</div>
									<p><%= post.excerpt %></p>
									<div class="bms-btn mt-45">
										<a href="/blog/<%= post.slug %>" class="grb-border-btn st-1">Lire plus</a>
									</div>
								</div>
							</div>
						<% }) %>
					</div>
				</div>
				<div class="col-lg-4">
					<div class="blog-sidebar">
						<%- include('../partials/blog-sidebar') %>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="newsletter-area">
		<div class="container">
			<div class="row wow fadeInUp align-items-center">
				<div class="col-lg-6">
					<div class="newsletter-text mb-30">
						<h4>Inscrivez-vous à la newsletter</h4>
						<p>Recevez nos actualités et conseils digital, directement dans votre boîte mail.</p>
					</div>
				</div>
				<div class="col-lg-6">
					<form class="subscribe-form mb-30">
						<input type="email" placeholder="Votre email...">
						<button type="submit"><i class="fas fa-paper-plane"></i>S'inscrire</button>
					</form>
				</div>
			</div>
		</div>
	</div>
</main>
