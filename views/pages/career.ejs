<main>
	<section class="page-title-area" data-background="/assets/front/img/bg/hire-bg.jpg">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<div class="page-title-content text-center">
						<div class="page-title-heading">
							<h1><%= t('career.heading') %></h1>
						</div>
						<nav class="grb-breadcrumb">
							<ol class="breadcrumb">
								<li class="breadcrumb-item"><a href="/"><%= t('nav.home') %></a></li>
								<li class="breadcrumb-item active" aria-current="page"><%= t('career.heading') %></li>
							</ol>
						</nav>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="pt-140 pb-90">
		<div class="container">
			<div class="row wow fadeInUp align-items-center mb-55">
				<div class="col-lg-6">
					<div class="section-title mb-30">
						<h2><%= t('career.title') %></h2>
					</div>
				</div>
				<div class="col-lg-6">
					<p class="mb-30"><%= t('career.lead') %></p>
				</div>
			</div>
			<% if (!jobs.length) { %>
				<div class="career-empty wow fadeInUp">
					<h2><%= t('career.emptyTitle') %></h2>
					<p><%= t('career.emptyText') %></p>
					<a href="/contact?sujet=Recrutement" class="grb-btn"><%= t('career.applyOpen') %></a>
				</div>
			<% } else { %>
				<% jobs.forEach((job) => { %>
					<div class="job-offer-card wow fadeInUp">
						<h3><a href="/carriere/<%= job.slug %>"><%= job.title %></a></h3>
						<div class="job-offer-meta">
							<% if (job.contract_type) { %><span><i class="fas fa-briefcase"></i><%= job.contract_type %></span><% } %>
							<% if (job.location) { %><span><i class="fas fa-map-marker-alt"></i><%= job.location %></span><% } %>
							<span><i class="fas fa-calendar-alt"></i><%= helpers.formatLongDate(job.created_at, lang) %></span>
						</div>
						<% if (job.description_html) { %>
							<p><%= helpers.stripHtml(job.description_html).slice(0, 180) %><%= helpers.stripHtml(job.description_html).length > 180 ? '…' : '' %></p>
						<% } %>
						<div class="mt-30">
							<a href="/carriere/<%= job.slug %>" class="grb-border-btn st-1"><%= t('career.view') %></a>
						</div>
					</div>
				<% }) %>
			<% } %>
		</div>
	</section>
	<%- include('../partials/newsletter') %>
</main>
