<main>
	<!-- page title area start  -->
	<section class="page-title-area" data-background="/assets/front/img/bg/hire-bg.jpg">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<div class="page-title-content text-center">
						<div class="page-title-heading">
							<h1><%= t('contact.heading') %></h1>
						</div>
						<nav class="grb-breadcrumb">
							<ol class="breadcrumb">
								<li class="breadcrumb-item"><a href="/"><%= t('nav.home') %></a></li>
								<li class="breadcrumb-item active" aria-current="page"><%= t('contact.heading') %></li>
							</ol>
						</nav>
					</div>
				</div>
			</div>
		</div>
	</section>
	<!-- page title area end -->
	<!-- contact area start  -->
	<div class="contact-area pt-145 pb-120">
		<div class="container">
			<div class="row wow fadeInUp">
				<div class="col-lg-4">
					<div class="contact-address">
						<div class="contact-heading">
							<p class="quote-kicker"><%= t('contact.coords') %></p>
							<h4><%= t('contact.reach') %></h4>
							<p class="contact-lead"><%= t('contact.lead') %></p>
						</div>
						<ul class="contact-address-list">
							<li>
								<div class="contact-list-icon">
									<i class="fas fa-phone-alt"></i>
								</div>
								<div class="contact-list-text">
									<span><a href="tel:<%= helpers.telHref(settings.phone) %>"><%= settings.phone %></a></span>
									<span><%= settings.hours %></span>
								</div>
							</li>
							<li>
								<div class="contact-list-icon st-3">
									<i class="fas fa-envelope"></i>
								</div>
								<div class="contact-list-text">
									<span><a href="mailto:<%= settings.email %>"><%= settings.email %></a></span>
									<span><%= t('contact.reply') %></span>
								</div>
							</li>
							<li>
								<div class="contact-list-icon">
									<i class="fas fa-map-marker-alt"></i>
								</div>
								<div class="contact-list-text">
									<span><%= settings.place.address %></span>
									<span><%= settings.place.regionCountry %></span>
								</div>
							</li>
						</ul>
					</div>
				</div>
				<div class="col-lg-8">
					<div class="get-in-touch">
						<div class="contact-heading">
							<p class="quote-kicker"><%= t('contact.write') %></p>
							<h4><%= t('contact.sendTitle') %></h4>
							<p class="contact-lead"><%= t('contact.sendLead') %></p>
						</div>
						<form class="cms-form" id="contact-form" action="/contact" method="post" novalidate><input type="hidden" name="_csrf" value="<%= csrfToken %>">
							<input type="text" name="website" tabindex="-1" autocomplete="off" class="quote-hp" aria-hidden="true">
							<div class="cms-form-grid">
								<label>
									<span><%= t('contact.firstName') %> <abbr class="req" title="<%= t('contact.required') %>">*</abbr></span>
									<input type="text" name="firstname" required maxlength="120" autocomplete="given-name" placeholder="Aminata">
								</label>
								<label>
									<span><%= t('contact.lastName') %> <abbr class="req" title="<%= t('contact.required') %>">*</abbr></span>
									<input type="text" name="lastname" required maxlength="120" autocomplete="family-name" placeholder="Sow">
								</label>
								<label>
									<span><%= t('contact.email') %> <abbr class="req" title="<%= t('contact.required') %>">*</abbr></span>
									<input type="email" name="email" required maxlength="180" autocomplete="email" placeholder="vous@entreprise.sn">
								</label>
								<label>
									<span><%= t('contact.phone') %></span>
									<input type="tel" name="phone" maxlength="80" autocomplete="tel" placeholder="+221 77 000 00 00">
								</label>
								<label class="cms-form-full">
									<span><%= t('contact.subject') %> <abbr class="req" title="<%= t('contact.required') %>">*</abbr></span>
									<select name="subject" required data-placeholder="<%= t('contact.chooseSubject') %>">
										<option value=""><%= t('contact.chooseSubject') %></option>
										<% (typeof contactSubjects !== 'undefined' ? contactSubjects : []).forEach((item) => { %>
											<option value="<%= item %>" <%= typeof selectedSubject !== 'undefined' && selectedSubject === item ? 'selected' : '' %>><%= t('contact.subjects', item) %></option>
										<% }) %>
									</select>
								</label>
								<label class="cms-form-full">
									<span><%= t('contact.message') %> <abbr class="req" title="<%= t('contact.required') %>">*</abbr></span>
									<textarea name="message" rows="6" required maxlength="4000" placeholder="<%= t('contact.messagePh') %>"></textarea>
								</label>
							</div>
							<p class="quote-form-error" data-contact-error hidden></p>
							<div class="quote-actions">
								<button class="quote-btn quote-btn-primary" type="submit">
									<span class="quote-btn-idle"><i class="fas fa-paper-plane"></i> <%= t('contact.send') %></span>
									<span class="quote-btn-busy" hidden><i class="fas fa-spinner fa-spin"></i> <%= t('contact.sending') %></span>
								</button>
							</div>
						</form>
						<div class="quote-success" data-contact-success hidden>
							<div class="quote-success-icon"><i class="fas fa-check"></i></div>
							<h3><%= t('contact.sentTitle') %></h3>
							<p><%= t('contact.sentText') %></p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- contact area end -->
	<!-- map area start  -->
	<div class="contact-map-area">
		<iframe src="<%= settings.map_embed %>" allowfullscreen="" loading="lazy"></iframe>
	</div>
	<!-- map area end -->
	<%- include('../partials/client-logos-slider', { extraClass: 'grey-bg' }) %>
	<!-- newsletter area start  -->
	<%- include('../partials/newsletter') %>
	<!-- newsletter area end -->
</main>
