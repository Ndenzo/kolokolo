<main>
	<section class="page-title-area" data-background="/assets/front/img/bg/hire-bg.jpg">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<div class="page-title-content text-center">
						<div class="page-title-heading">
							<h1><%= t('career.heading') %></h1>
						</div>
						<nav class="grb-breadcrumb">
							<ol class="breadcrumb">
								<li class="breadcrumb-item"><a href="/"><%= t('nav.home') %></a></li>
								<li class="breadcrumb-item"><a href="/carriere"><%= t('career.heading') %></a></li>
								<li class="breadcrumb-item active" aria-current="page"><%= job.title %></li>
							</ol>
						</nav>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="pt-140 pb-90">
		<div class="container">
			<div class="row wow fadeInUp">
				<div class="col-lg-8">
					<div class="job-offer-card">
						<h2><%= job.title %></h2>
						<div class="job-offer-meta">
							<% if (job.contract_type) { %><span><i class="fas fa-briefcase"></i><%= job.contract_type %></span><% } %>
							<% if (job.location) { %><span><i class="fas fa-map-marker-alt"></i><%= job.location %></span><% } %>
							<span><i class="fas fa-calendar-alt"></i><%= helpers.formatLongDate(job.created_at, lang) %></span>
						</div>
						<div class="bm-rich"><%- job.description_html || '' %></div>
						<div class="mt-40">
							<a href="/contact?sujet=Recrutement" class="grb-btn"><%= t('career.apply') %></a>
						</div>
					</div>
				</div>
				<div class="col-lg-4">
					<div class="contact-address">
						<div class="contact-heading">
							<h4><%= t('career.application') %></h4>
						</div>
						<ul class="contact-address-list">
							<li>
								<div class="contact-list-icon">
									<i class="fas fa-phone-alt"></i>
								</div>
								<div class="contact-list-text">
									<span><a href="tel:<%= helpers.telHref(settings.phone) %>"><%= settings.phone %></a></span>
									<span><%= settings.hours %></span>
								</div>
							</li>
							<li>
								<div class="contact-list-icon st-3">
									<i class="fas fa-envelope"></i>
								</div>
								<div class="contact-list-text">
									<span><a href="mailto:<%= settings.email %>"><%= settings.email %></a></span>
									<span><%= t('contact.reply') %></span>
								</div>
							</li>
							<li>
								<div class="contact-list-icon">
									<i class="fas fa-map-marker-alt"></i>
								</div>
								<div class="contact-list-text">
									<span><%= settings.place.address %></span>
									<span><%= settings.place.regionCountry %></span>
								</div>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>
	<%- include('../partials/newsletter') %>
</main>
