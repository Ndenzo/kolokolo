<main>
	<section class="page-title-area" data-background="/assets/front/img/bg/hire-bg.jpg">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<div class="page-title-content text-center">
						<div class="page-title-heading">
							<h1><%= t('about.heading') %></h1>
						</div>
						<nav class="grb-breadcrumb">
							<ol class="breadcrumb">
								<li class="breadcrumb-item"><a href="/"><%= t('nav.home') %></a></li>
								<li class="breadcrumb-item active" aria-current="page"><%= t('about.heading') %></li>
							</ol>
						</nav>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="about-details pt-140 pb-90">
		<div class="container">
			<div class="row wow fadeInUp align-items-center">
				<div class="col-lg-6">
					<div class="section-title mb-30">
						<h2><%= t('about.title') %></h2>
					</div>
				</div>
				<div class="col-lg-6">
					<div class="about-details-right mb-30">
						<p><%= t('about.lead') %></p>
					</div>
				</div>
			</div>
			<div class="about-details-box mt-30" data-background="/assets/front/img/bg/about-details-bg.jpg">
				<div class="row wow fadeInUp justify-content-end">
					<div class="col-xl-6 col-md-10">
						<div class="about-details-box-content">
							<h5><%= t('about.boxTitle') %></h5>
							<p><%= t('about.boxText') %></p>
							<ul class="about-points st-ab">
								<li>
									<div class="points-heading">
										<div class="p-icon">
											<i class="flaticon-team"></i>
										</div>
										<h5><%= t('home.quality') %></h5>
									</div>
									<p><%= t('home.qualityText') %></p>
								</li>
								<li>
									<div class="points-heading">
										<div class="p-icon">
											<i class="flaticon-creative-team"></i>
										</div>
										<h5><%= t('home.innovation') %></h5>
									</div>
									<p><%= t('home.innovationText') %></p>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="service__area grey-bg pt-120 pb-90">
		<div class="container">
			<div class="row wow fadeInUp">
				<div class="col-lg-6">
					<div class="section-title mb-55">
						<div class="border-left">
							<p><%= t('home.ourServices') %></p>
						</div>
						<h2><%= t('home.bestServices') %></h2>
					</div>
				</div>
				<div class="col-lg-6">
					<div class="service__text mb-30">
						<p><%= t('home.servicesLead') %></p>
					</div>
				</div>
			</div>
			<%- include('../partials/services-grid') %>
		</div>
	</section>
	<div class="counter-board-area" data-background="/assets/front/img/bg/hire-bg.jpg">
		<div class="container">
			<div class="row wow fadeInUp counter-board-content">
				<div class="col-lg-3 col-sm-6">
					<div class="counter-board-single mb-40">
						<i class="flaticon-crm"></i>
						<div class="counter-board-number"><span class="odometer" data-count="50">00</span>+</div>
						<p><%= t('home.clients') %></p>
					</div>
				</div>
				<div class="col-lg-3 col-sm-6">
					<div class="counter-board-single mb-40">
						<i class="flaticon-new-product"></i>
						<div class="counter-board-number"><span class="odometer" data-count="30">00</span>+</div>
						<p><%= t('home.products') %></p>
					</div>
				</div>
				<div class="col-lg-3 col-sm-6">
					<div class="counter-board-single mb-40">
						<i class="flaticon-delivery-box"></i>
						<div class="counter-board-number"><span class="odometer" data-count="4">00</span></div>
						<p><%= t('home.unique') %></p>
					</div>
				</div>
				<div class="col-lg-3 col-sm-6">
					<div class="counter-board-single mb-40">
						<i class="flaticon-employee"></i>
						<div class="counter-board-number"><span class="odometer" data-count="10">00</span>+</div>
						<p><%= t('home.experts') %></p>
					</div>
				</div>
			</div>
		</div>
	</div>
	<section class="skill-area pt-110 pb-85 grey-bg">
		<div class="container">
			<div class="row wow fadeInUp">
				<div class="col-lg-6">
					<div class="about__content mb-30">
						<div class="section-title mb-30">
							<h2><%= t('about.skillsTitle') %></h2>
						</div>
						<div class="ab-experience st-3">
							<div class="ab-experience-content">
								<div class="ab-experience-icon">
									<i class="flaticon-trophy"></i>
								</div>
								<div class="ab-experience-text">
									<p><span><%= t('about.dakar') %></span><%= t('about.senegal') %></p>
								</div>
							</div>
						</div>
						<p><%= t('about.skillsLead') %></p>
					</div>
				</div>
				<div class="col-lg-6">
					<div class="grb-skill mt-45 ml-20 mr-10">
						<div class="skill-wrapper">
							<div class="skill-title">
								<h5 class="skill-category"><%= t('services.items.web.name') %></h5>
								<span>95%</span>
							</div>
							<div class="progress">
								<div class="progress-bar wow slideInLeft" role="progressbar" style="width: 95%" aria-valuenow="95" aria-valuemin="0" aria-valuemax="100"></div>
							</div>
						</div>
						<div class="skill-wrapper">
							<div class="skill-title">
								<h5 class="skill-category"><%= t('services.items.app.name') %></h5>
								<span>90%</span>
							</div>
							<div class="progress">
								<div class="progress-bar wow slideInLeft" role="progressbar" style="width: 90%" aria-valuenow="90" aria-valuemin="0" aria-valuemax="100"></div>
							</div>
						</div>
						<div class="skill-wrapper">
							<div class="skill-title">
								<h5 class="skill-category"><%= t('services.items.ads.name') %></h5>
								<span>85%</span>
							</div>
							<div class="progress">
								<div class="progress-bar wow slideInLeft" role="progressbar" style="width: 85%" aria-valuenow="85" aria-valuemin="0" aria-valuemax="100"></div>
							</div>
						</div>
						<div class="skill-wrapper">
							<div class="skill-title">
								<h5 class="skill-category"><%= t('services.items.social.name') %></h5>
								<span>88%</span>
							</div>
							<div class="progress">
								<div class="progress-bar wow slideInLeft" role="progressbar" style="width: 88%" aria-valuenow="88" aria-valuemin="0" aria-valuemax="100"></div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<%- include('../partials/client-logos-slider') %>
	<%- include('../partials/newsletter') %>
</main>
