<main>
	<section class="page-title-area" data-background="/assets/front/img/bg/hire-bg.jpg">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<div class="page-title-content text-center">
						<div class="page-title-heading">
							<h1><%= t('services.heading') %></h1>
						</div>
						<nav class="grb-breadcrumb">
							<ol class="breadcrumb">
								<li class="breadcrumb-item"><a href="/"><%= t('nav.home') %></a></li>
								<li class="breadcrumb-item active" aria-current="page"><%= t('services.heading') %></li>
							</ol>
						</nav>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="service-box-area service-box-area-main pt-150 pb-80">
		<div class="container">
			<%- include('../partials/services-grid') %>
		</div>
	</section>
	<section class="pricing-area pt-120 pb-90 grey-bg">
		<div class="container">
			<div class="pricing-inner">
				<div class="row wow fadeInUp">
					<div class="col-lg-7 col-md-8">
						<div class="section-title mb-30">
							<h2><%= t('services.pricingTitle') %></h2>
						</div>
					</div>
				</div>
				<div class="pricing-plans wow fadeInUp">
					<ul class="nav nav-tabs" id="pricingTab" role="tablist">
						<li class="nav-item" role="presentation">
							<button class="nav-link active" id="monthly-tab" data-bs-toggle="tab" data-bs-target="#monthly" type="button" role="tab" aria-controls="monthly" aria-selected="true"><%= t('services.monthly') %></button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="yearly-tab" data-bs-toggle="tab" data-bs-target="#yearly" type="button" role="tab" aria-controls="yearly" aria-selected="false"><%= t('services.yearly') %></button>
						</li>
					</ul>
					<div class="tab-content" id="pricingTabContent">
						<div class="tab-pane fade show active" id="monthly" role="tabpanel" aria-labelledby="monthly-tab">
							<div class="row g-0">
								<div class="col-lg-4 col-md-6">
									<div class="single-pricing mb-30">
										<div class="pricing-title">
											<h5><%= t('services.essential') %></h5>
											<span>150 000 F</span>
										</div>
										<ul class="pricing-list">
											<li><%= t('services.e1') %></li>
											<li><%= t('services.e2') %></li>
											<li><%= t('services.e3') %></li>
											<li><%= t('services.e4m') %></li>
											<li><%= t('services.e5') %></li>
											<li><%= t('services.e6') %></li>
										</ul>
										<div class="pricing-btn text-center">
											<a href="#devis" class="grb-border-btn st-1" data-quote-open data-quote-offer="Essentiel"><%= t('services.choose') %></a>
										</div>
									</div>
								</div>
								<div class="col-lg-4 col-md-6">
									<div class="single-pricing mb-30">
										<div class="pricing-title">
											<h5><%= t('services.business') %></h5>
											<span>350 000 F</span>
										</div>
										<ul class="pricing-list">
											<li><%= t('services.b1') %></li>
											<li><%= t('services.b2') %></li>
											<li><%= t('services.b3') %></li>
											<li><%= t('services.b4') %></li>
											<li><%= t('services.b5') %></li>
											<li><%= t('services.b6') %></li>
										</ul>
										<div class="pricing-btn text-center">
											<a href="#devis" class="grb-border-btn st-1" data-quote-open data-quote-offer="Business"><%= t('services.choose') %></a>
										</div>
									</div>
								</div>
								<div class="col-lg-4 col-md-6">
									<div class="single-pricing mb-30">
										<div class="pricing-title">
											<h5><%= t('services.premium') %></h5>
											<span>650 000 F</span>
										</div>
										<ul class="pricing-list">
											<li><%= t('services.p1') %></li>
											<li><%= t('services.p2') %></li>
											<li><%= t('services.p3') %></li>
											<li><%= t('services.p4') %></li>
											<li><%= t('services.p5') %></li>
											<li><%= t('services.p6') %></li>
										</ul>
										<div class="pricing-btn text-center">
											<a href="#devis" class="grb-border-btn st-1" data-quote-open data-quote-offer="Premium"><%= t('services.choose') %></a>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="tab-pane fade" id="yearly" role="tabpanel" aria-labelledby="yearly-tab">
							<div class="row g-0">
								<div class="col-lg-4 col-md-6">
									<div class="single-pricing mb-30">
										<div class="pricing-title">
											<h5><%= t('services.essential') %></h5>
											<span>1 500 000 F</span>
										</div>
										<ul class="pricing-list">
											<li><%= t('services.e1') %></li>
											<li><%= t('services.e2') %></li>
											<li><%= t('services.e3') %></li>
											<li><%= t('services.e4y') %></li>
											<li><%= t('services.e5') %></li>
											<li><%= t('services.e6') %></li>
										</ul>
										<div class="pricing-btn text-center">
											<a href="#devis" class="grb-border-btn st-1" data-quote-open data-quote-offer="Essentiel"><%= t('services.choose') %></a>
										</div>
									</div>
								</div>
								<div class="col-lg-4 col-md-6">
									<div class="single-pricing mb-30">
										<div class="pricing-title">
											<h5><%= t('services.business') %></h5>
											<span>3 500 000 F</span>
										</div>
										<ul class="pricing-list">
											<li><%= t('services.b1') %></li>
											<li><%= t('services.b2') %></li>
											<li><%= t('services.b3') %></li>
											<li><%= t('services.b4') %></li>
											<li><%= t('services.b5') %></li>
											<li><%= t('services.b6') %></li>
										</ul>
										<div class="pricing-btn text-center">
											<a href="#devis" class="grb-border-btn st-1" data-quote-open data-quote-offer="Business"><%= t('services.choose') %></a>
										</div>
									</div>
								</div>
								<div class="col-lg-4 col-md-6">
									<div class="single-pricing mb-30">
										<div class="pricing-title">
											<h5><%= t('services.premium') %></h5>
											<span>6 500 000 F</span>
										</div>
										<ul class="pricing-list">
											<li><%= t('services.p1') %></li>
											<li><%= t('services.p2') %></li>
											<li><%= t('services.p3') %></li>
											<li><%= t('services.p4') %></li>
											<li><%= t('services.p5') %></li>
											<li><%= t('services.p6') %></li>
										</ul>
										<div class="pricing-btn text-center">
											<a href="#devis" class="grb-border-btn st-1" data-quote-open data-quote-offer="Premium"><%= t('services.choose') %></a>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="partners-area pt-80 pb-80">
		<div class="container">
			<div class="row wow fadeInUp">
				<div class="col-lg-6">
					<div class="partners-content mb-40">
						<div class="section-title mb-35">
							<h2><%= t('services.trust') %></h2>
						</div>
						<p><%= t('services.trustText') %></p>
					</div>
				</div>
				<div class="col-lg-6">
					<div class="partners-logo pl-100">
						<div class="row">
							<% (typeof clientLogos !== 'undefined' ? clientLogos : []).forEach((logo, index) => { %>
								<div class="col-sm-6">
									<div class="single-partner<%= index % 2 ? ' text-end' : '' %>">
										<a href="<%= logo.url || '#' %>"<% if (logo.url) { %> target="_blank" rel="noopener noreferrer"<% } %>>
											<img src="<%= logo.logo_color %>" alt="<%= logo.name %>">
										</a>
									</div>
								</div>
							<% }) %>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="hire-area" data-background="/assets/front/img/bg/hire-bg.jpg">
		<div class="container">
			<div class="row wow fadeInUp justify-content-center">
				<div class="col-lg-8 col-md-11">
					<div class="hire-content text-center">
						<div class="section-title mb-55">
							<h2 class="white-color"><%= t('services.project') %></h2>
						</div>
						<div class="hire-btn">
							<a href="#devis" class="grb-btn" data-quote-open><%= t('services.talk') %></a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<% const serviceTestimonials = typeof testimonials !== 'undefined' ? testimonials : []; %>
	<% if (serviceTestimonials.length) { %>
	<div class="testimonial-area st-2 grey-bg">
		<div class="container">
			<div class="row wow fadeInUp align-items-center">
				<div class="col-lg-6">
					<div class="section-title mb-30">
						<div class="border-left">
							<p><%= t('home.testimonials') %></p>
						</div>
						<h2><%= t('home.testimonialsTitle') %> <br> <%= t('home.testimonialsTitle2') %></h2>
					</div>
					<div class="swiper-container testimonial-active-2 st-3">
						<div class="swiper-wrapper">
							<% serviceTestimonials.forEach((item) => { %>
							<div class="swiper-slide" data-photo="<%= item.photo || '/assets/front/img/testimonial/test1.png' %>" data-name="<%= item.name %>">
								<div class="testimonial-single">
									<p class="mb-30"><%= item.content %></p>
									<div class="testimonial-name">
										<h5><%= item.name %></h5>
										<p><%= item.role %></p>
									</div>
								</div>
							</div>
							<% }) %>
						</div>
						<div class="testimonial-nav-2">
							<div class="testimonial2-btn-prev"><i class="fal fa-angle-left"></i></div>
							<div class="testimonial2-btn-next"><i class="fal fa-angle-right"></i></div>
						</div>
					</div>
				</div>
				<div class="col-lg-6 d-none d-lg-block">
					<div class="testimonial-right p-relative">
						<div class="test-i-img">
							<img data-testimonial-client-photo src="<%= serviceTestimonials[0].photo || '/assets/front/img/testimonial/test1.png' %>" alt="<%= serviceTestimonials[0].name %>">
						</div>
						<div class="testimonial-right-img p-relative">
							<img src="/assets/front/img/testimonial/test-r-img.jpg" alt="">
							<div class="testimonial-quote pos-2">
								<i class="fal fa-quote-left"></i>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<% } %>
	<%- include('../partials/newsletter') %>
</main>
