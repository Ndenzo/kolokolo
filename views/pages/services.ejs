<main>
	<section class="page-title-area" data-background="/assets/front/img/bg/hire-bg.jpg">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<div class="page-title-content text-center">
						<div class="page-title-heading">
							<h1>Services</h1>
						</div>
						<nav class="grb-breadcrumb">
							<ol class="breadcrumb">
								<li class="breadcrumb-item"><a href="/">Accueil</a></li>
								<li class="breadcrumb-item active" aria-current="page">Services</li>
							</ol>
						</nav>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="service-box-area service-box-area-main pt-150 pb-80">
		<div class="container">
			<%- include('../partials/services-grid') %>
		</div>
	</section>
	<section class="pricing-area pt-120 pb-90 grey-bg">
		<div class="container">
			<div class="pricing-inner">
				<div class="row wow fadeInUp">
					<div class="col-lg-7 col-md-8">
						<div class="section-title mb-30">
							<h2>Des formules pensées pour vos projets</h2>
						</div>
					</div>
				</div>
				<div class="pricing-plans wow fadeInUp">
					<ul class="nav nav-tabs" id="pricingTab" role="tablist">
						<li class="nav-item" role="presentation">
							<button class="nav-link active" id="monthly-tab" data-bs-toggle="tab" data-bs-target="#monthly" type="button" role="tab" aria-controls="monthly" aria-selected="true">Mensuel</button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="yearly-tab" data-bs-toggle="tab" data-bs-target="#yearly" type="button" role="tab" aria-controls="yearly" aria-selected="false">Annuel</button>
						</li>
					</ul>
					<div class="tab-content" id="pricingTabContent">
						<div class="tab-pane fade show active" id="monthly" role="tabpanel" aria-labelledby="monthly-tab">
							<div class="row g-0">
								<div class="col-lg-4 col-md-6">
									<div class="single-pricing mb-30">
										<div class="pricing-title">
											<h5>Essentiel</h5>
											<span>150 000 F</span>
										</div>
										<ul class="pricing-list">
											<li>Site vitrine</li>
											<li>Identité visuelle de base</li>
											<li>Référencement de départ</li>
											<li>Hébergement 1 mois</li>
											<li>Support email</li>
											<li>1 révision incluse</li>
										</ul>
										<div class="pricing-btn text-center">
											<a href="#devis" class="grb-border-btn st-1" data-quote-open data-quote-offer="Essentiel">Choisir cette offre</a>
										</div>
									</div>
								</div>
								<div class="col-lg-4 col-md-6">
									<div class="single-pricing mb-30">
										<div class="pricing-title">
											<h5>Business</h5>
											<span>350 000 F</span>
										</div>
										<ul class="pricing-list">
											<li>Site web ou e-commerce</li>
											<li>Publicité digitale</li>
											<li>Gestion réseaux sociaux</li>
											<li>Reporting mensuel</li>
											<li>Support prioritaire</li>
											<li>3 révisions incluses</li>
										</ul>
										<div class="pricing-btn text-center">
											<a href="#devis" class="grb-border-btn st-1" data-quote-open data-quote-offer="Business">Choisir cette offre</a>
										</div>
									</div>
								</div>
								<div class="col-lg-4 col-md-6">
									<div class="single-pricing mb-30">
										<div class="pricing-title">
											<h5>Premium</h5>
											<span>650 000 F</span>
										</div>
										<ul class="pricing-list">
											<li>Site web + application</li>
											<li>Campagnes publicitaires</li>
											<li>Social media complet</li>
											<li>Accompagnement dédié</li>
											<li>Formation de vos équipes</li>
											<li>Révisions illimitées</li>
										</ul>
										<div class="pricing-btn text-center">
											<a href="#devis" class="grb-border-btn st-1" data-quote-open data-quote-offer="Premium">Choisir cette offre</a>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="tab-pane fade" id="yearly" role="tabpanel" aria-labelledby="yearly-tab">
							<div class="row g-0">
								<div class="col-lg-4 col-md-6">
									<div class="single-pricing mb-30">
										<div class="pricing-title">
											<h5>Essentiel</h5>
											<span>1 500 000 F</span>
										</div>
										<ul class="pricing-list">
											<li>Site vitrine</li>
											<li>Identité visuelle de base</li>
											<li>Référencement de départ</li>
											<li>Hébergement 12 mois</li>
											<li>Support email</li>
											<li>1 révision incluse</li>
										</ul>
										<div class="pricing-btn text-center">
											<a href="#devis" class="grb-border-btn st-1" data-quote-open data-quote-offer="Essentiel">Choisir cette offre</a>
										</div>
									</div>
								</div>
								<div class="col-lg-4 col-md-6">
									<div class="single-pricing mb-30">
										<div class="pricing-title">
											<h5>Business</h5>
											<span>3 500 000 F</span>
										</div>
										<ul class="pricing-list">
											<li>Site web ou e-commerce</li>
											<li>Publicité digitale</li>
											<li>Gestion réseaux sociaux</li>
											<li>Reporting mensuel</li>
											<li>Support prioritaire</li>
											<li>3 révisions incluses</li>
										</ul>
										<div class="pricing-btn text-center">
											<a href="#devis" class="grb-border-btn st-1" data-quote-open data-quote-offer="Business">Choisir cette offre</a>
										</div>
									</div>
								</div>
								<div class="col-lg-4 col-md-6">
									<div class="single-pricing mb-30">
										<div class="pricing-title">
											<h5>Premium</h5>
											<span>6 500 000 F</span>
										</div>
										<ul class="pricing-list">
											<li>Site web + application</li>
											<li>Campagnes publicitaires</li>
											<li>Social media complet</li>
											<li>Accompagnement dédié</li>
											<li>Formation de vos équipes</li>
											<li>Révisions illimitées</li>
										</ul>
										<div class="pricing-btn text-center">
											<a href="#devis" class="grb-border-btn st-1" data-quote-open data-quote-offer="Premium">Choisir cette offre</a>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="partners-area pt-80 pb-80">
		<div class="container">
			<div class="row wow fadeInUp">
				<div class="col-lg-6">
					<div class="partners-content mb-40">
						<div class="section-title mb-35">
							<h2>Ils nous font confiance</h2>
						</div>
						<p>Notre équipe accompagne des entreprises sénégalaises et internationales dans la réussite de leurs projets digitaux, du premier brief jusqu'au suivi après mise en ligne.</p>
					</div>
				</div>
				<div class="col-lg-6">
					<div class="partners-logo pl-100">
						<div class="row">
							<div class="col-sm-6">
								<div class="single-partner">
									<a href="#"><img src="/assets/front/img/brand/brand1.png" alt=""></a>
								</div>
							</div>
							<div class="col-sm-6">
								<div class="single-partner text-end">
									<a href="#"><img src="/assets/front/img/brand/brand2.png" alt=""></a>
								</div>
							</div>
							<div class="col-sm-12">
								<div class="single-partner text-center">
									<a href="#"><img src="/assets/front/img/brand/brand3.png" alt=""></a>
								</div>
							</div>
							<div class="col-sm-6">
								<div class="single-partner">
									<a href="#"><img src="/assets/front/img/brand/brand4.png" alt=""></a>
								</div>
							</div>
							<div class="col-sm-6">
								<div class="single-partner text-end">
									<a href="#"><img src="/assets/front/img/brand/brand5.png" alt=""></a>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="hire-area" data-background="/assets/front/img/bg/hire-bg.jpg">
		<div class="container">
			<div class="row wow fadeInUp justify-content-center">
				<div class="col-lg-8 col-md-11">
					<div class="hire-content text-center">
						<div class="section-title mb-55">
							<h2 class="white-color">Avez-vous un projet ?</h2>
						</div>
						<div class="hire-btn">
							<a href="#devis" class="grb-btn" data-quote-open>Parlons-en</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<% const serviceTestimonials = typeof testimonials !== 'undefined' ? testimonials : []; %>
	<% if (serviceTestimonials.length) { %>
	<div class="testimonial-area st-2 grey-bg">
		<div class="container">
			<div class="row wow fadeInUp align-items-center">
				<div class="col-lg-6">
					<div class="section-title mb-30">
						<div class="border-left">
							<p>Témoignages</p>
						</div>
						<h2>Nos clients sont ravis <br> d'avoir collaboré avec nous</h2>
					</div>
					<div class="swiper-container testimonial-active-2 st-3">
						<div class="swiper-wrapper">
							<% serviceTestimonials.forEach((item) => { %>
							<div class="swiper-slide">
								<div class="testimonial-single">
									<p class="mb-30"><%= item.content %></p>
									<div class="testimonial-name">
										<h5><%= item.name %></h5>
										<p><%= item.role %></p>
									</div>
								</div>
							</div>
							<% }) %>
						</div>
						<div class="testimonial-nav-2">
							<div class="testimonial2-btn-prev"><i class="fal fa-angle-left"></i></div>
							<div class="testimonial2-btn-next"><i class="fal fa-angle-right"></i></div>
						</div>
					</div>
				</div>
				<div class="col-lg-6 d-none d-lg-block">
					<div class="testimonial-right p-relative">
						<div class="test-i-img">
							<img src="/assets/front/img/testimonial/test-i-img.jpg" alt="">
						</div>
						<div class="testimonial-right-img p-relative">
							<img src="/assets/front/img/testimonial/test-r-img.jpg" alt="">
							<div class="testimonial-quote pos-2">
								<i class="fal fa-quote-left"></i>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<% } %>
	<div class="newsletter-area">
		<div class="container">
			<div class="row wow fadeInUp align-items-center">
				<div class="col-lg-6">
					<div class="newsletter-text mb-30">
						<h4>Inscrivez-vous à la newsletter</h4>
						<p>Recevez nos actualités et conseils digitaux, directement dans votre boîte mail.</p>
					</div>
				</div>
				<div class="col-lg-6">
					<form class="subscribe-form mb-30">
						<input type="email" placeholder="Votre email...">
						<button type="submit"><i class="fas fa-paper-plane"></i>S'inscrire</button>
					</form>
				</div>
			</div>
		</div>
	</div>
</main>
