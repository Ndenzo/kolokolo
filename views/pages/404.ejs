<main>
	<section class="page-title-area" data-background="/assets/front/img/bg/hire-bg.jpg">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<div class="page-title-content text-center">
						<div class="page-title-heading">
							<h1><%= t('notFound.heading') %></h1>
						</div>
						<nav class="grb-breadcrumb">
							<ol class="breadcrumb">
								<li class="breadcrumb-item"><a href="/"><%= t('nav.home') %></a></li>
								<li class="breadcrumb-item active" aria-current="page">404</li>
							</ol>
						</nav>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="area-404 pt-120">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-lg-8">
					<div class="content-404 text-center mb-30">
						<h2>404</h2>
						<h4><%= t('notFound.title') %></h4>
						<p><%= t('notFound.text') %></p>
						<div class="search-404">
							<form class="search-form mb-30" action="/" method="get">
								<div class="search-input-field">
									<input type="text" name="q" placeholder="<%= t('nav.searchPlaceholder') %>">
									<button type="submit"><i class="far fa-search"></i></button>
								</div>
							</form>
						</div>
						<div class="go-home">
							<a href="/" class="grb-border-btn st-1"><%= t('notFound.home') %></a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<%- include('../partials/client-logos-slider', { extraClass: 'grey-bg' }) %>
	<%- include('../partials/newsletter') %>
</main>
