<%
	const head = helpers.buildHead({
		title,
		page: typeof page !== 'undefined' ? page : 'home',
		path: typeof canonicalPath !== 'undefined' ? canonicalPath : '/',
		settings: typeof settings !== 'undefined' ? settings : {},
		siteUrl: typeof siteUrl !== 'undefined' ? siteUrl : 'https://kolokolo.tech',
		post: typeof post !== 'undefined' ? post : null,
		job: typeof job !== 'undefined' ? job : null,
		doc: typeof doc !== 'undefined' ? doc : null,
		description: typeof description !== 'undefined' ? description : '',
		image: typeof metaImage !== 'undefined' ? metaImage : '',
		t: typeof t === 'function' ? t : undefined,
	});
%>
<!doctype html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'fr' %>">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title><%= head.title %></title>
	<meta name="description" content="<%= head.description %>">
	<meta name="author" content="Kolokolo">
	<meta name="robots" content="<%= head.robots %>">
	<meta name="theme-color" content="#FF0A08">
	<link rel="canonical" href="<%= head.url %>">

	<meta property="og:type" content="<%= head.ogType %>">
	<meta property="og:site_name" content="Kolokolo">
	<meta property="og:locale" content="<%= typeof locale !== 'undefined' ? locale : 'fr_FR' %>">
	<meta property="og:title" content="<%= head.title %>">
	<meta property="og:description" content="<%= head.description %>">
	<meta property="og:url" content="<%= head.url %>">
	<meta property="og:image" content="<%= head.image %>">

	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="<%= head.title %>">
	<meta name="twitter:description" content="<%= head.description %>">
	<meta name="twitter:image" content="<%= head.image %>">

	<link rel="icon" type="image/png" sizes="32x32" href="/assets/custom/img/logo/favicon.png">
	<link rel="apple-touch-icon" href="/assets/custom/img/logo/logo.png">
	<link rel="manifest" href="/site.webmanifest">

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="preconnect" href="https://cdn.jsdelivr.net">

	<link rel="stylesheet" href="/assets/front/css/bootstrap.min.css">
	<link rel="stylesheet" href="/assets/front/css/swiper-bundle.css">
	<link rel="stylesheet" href="/assets/front/css/animate.min.css">
	<link rel="stylesheet" href="/assets/front/css/custom-animation.css">
	<link rel="stylesheet" href="/assets/front/css/magnific-popup.css">
	<link rel="stylesheet" href="/assets/front/css/odometer-theme-default.css">
	<link rel="stylesheet" href="/assets/front/css/fontawesome-all.min.css">
	<link rel="stylesheet" href="/assets/front/css/meanmenu.css">
	<link rel="stylesheet" href="/assets/front/css/flaticon.css">
	<link rel="stylesheet" href="/assets/front/css/main.css">
	<link rel="stylesheet" href="/assets/front/css/cms.css">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flag-icons@7.2.3/css/flag-icons.min.css">
	<script type="application/ld+json"><%- head.jsonLd %></script>
</head>

<body class="page-<%= typeof page !== 'undefined' ? page : 'default' %>">
	<%- include('partials/menu') %>

	<%- include('pages/' + page) %>

	<!-- footer area start  -->
	<footer>
		<section class="footer-area pt-80 pb-40">
			<div class="container">
				<div class="row wow fadeInUp">
					<div class="col-lg-4 col-md-6">
						<div class="footer-widget mb-40">
							<div class="question-area">
								<div class="question-icon">
									<i class="flaticon-support"></i>
								</div>
								<div class="question-text">
									<p><%= t('footer.question') %></p>
									<span><a href="tel:<%= helpers.telHref(settings.phone) %>"><%= settings.phone %></a></span>
								</div>
							</div>
							<div class="footer-address">
								<h5><%= t('footer.contact') %></h5>
								<p><%= settings.place.address %><br><%= settings.place.regionCountry %><br><%= settings.email %></p>
							</div>
							<div class="grb__social footer-social">
								<ul>
									<%- include('partials/social-items') %>
								</ul>
							</div>
						</div>
					</div>
					<div class="col-lg-3 col-md-6">
						<div class="footer-widget mb-40 cat-m">
							<div class="footer-widget-title">
								<h4><%= t('footer.links') %></h4>
							</div>
							<ul class="footer-list">
								<li><a href="/services"><%= t('nav.services') %></a></li>
								<li><a href="#"><%= t('footer.portfolio') %></a></li>
								<li><a href="/blog"><%= t('nav.blog') %></a></li>
								<li><a href="/contact"><%= t('nav.contact') %></a></li>
							</ul>
						</div>
					</div>
					<div class="col-lg-3 col-md-6">
						<div class="footer-widget mb-40">
							<div class="footer-widget-title">
								<h4><%= t('footer.agency') %></h4>
							</div>
							<ul class="footer-list">
								<li><a href="/a-propos"><%= t('nav.about') %></a></li>
								<li><a href="/contact"><%= t('nav.contact') %></a></li>
								<li><a href="/confidentialite"><%= t('footer.privacyPolicy') %></a></li>
								<li><a href="/conditions-generales"><%= t('footer.terms') %></a></li>
							</ul>
						</div>
					</div>
					<div class="col-lg-2 col-md-6">
						<div class="footer-widget mb-40 srv-m">
							<div class="footer-widget-title">
								<h4><%= t('footer.hours') %></h4>
							</div>
							<ul class="worktime-list">
								<li>
									<h5><%= t('footer.hours') %></h5>
									<span><%= settings.hours %></span>
								</li>
								<li>
									<h5><%= t('footer.weekend') %></h5>
									<span><%= settings.weekend_hours %></span>
								</li>
							</ul>
							<div class="footer-lang">
								<%- include('partials/lang-switch', { variant: 'dark' }) %>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
		<div class="copyright-area">
			<div class="container">
				<div class="row wow fadeInUp align-items-center">
					<div class="col-lg-3 d-none d-lg-block">
						<div class="copyright-logo logo-shape">
							<a href="/">
								<img src="/assets/custom/img/logo/logoh.png" alt="Kolokolo">
							</a>
						</div>
					</div>
					<div class="col-lg-4 col-md-6">
						<div class="copyright-text">
							<p>&copy; <%= new Date().getFullYear() %> <a href="/">Kolokolo</a>. <%= t('footer.rights') %></p>
						</div>
					</div>
					<div class="col-lg-5 col-md-6">
						<ul class="copyright-list f-right">
							<li><a href="/conditions-generales"><%= t('footer.terms') %></a></li>
							<li><a href="/confidentialite"><%= t('footer.privacy') %></a></li>
							<li><a href="/a-propos"><%= t('nav.about') %></a></li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</footer>
	<!-- footer area end -->

	<!-- JS here -->
	<script src="/assets/front/js/vendor/jquery-3.6.0.min.js"></script>
	<script src="/assets/front/js/bootstrap.bundle.min.js"></script>
	<script src="/assets/front/js/swiper-bundle.js"></script>
	<script src="/assets/front/js/isotope.pkgd.min.js"></script>
	<script src="/assets/front/js/jquery.meanmenu.min.js"></script>
	<script src="/assets/front/js/ajax-form.js"></script>
	<script src="/assets/front/js/wow.min.js"></script>
	<script src="/assets/front/js/jquery.scrollUp.min.js"></script>
	<script src="/assets/front/js/odometer.min.js"></script>
	<script src="/assets/front/js/appair.min.js"></script>
	<script src="/assets/front/js/imagesloaded.pkgd.min.js"></script>
	<script src="/assets/front/js/jquery.magnific-popup.min.js"></script>
	<script src="/assets/front/js/plugins.js"></script>
	<script src="/assets/front/js/main.js"></script>
	<script>window.KOLOKOLO_I18N = <%- JSON.stringify(typeof jsI18n !== 'undefined' ? jsI18n : {}) %>;</script>
	<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
	<% if (typeof lang === 'undefined' || lang === 'fr') { %>
	<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/i18n/fr.js"></script>
	<% } %>
	<%- include('partials/quote-modal') %>
	<script src="/assets/front/js/quote.js"></script>
	<script src="/assets/front/js/contact.js"></script>
	<script src="/assets/front/js/newsletter.js"></script>
	<script src="/assets/front/js/search.js"></script>
	<script src="/assets/front/js/lang.js"></script>
</body>

</html>
